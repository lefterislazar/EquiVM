def collectBodyEnterPostCallResult
    (ee : ExecutionEnv) (g : Sat256) (s0 : State) (mem : ByteArray)
    (awCallLoad : UInt256)
    (cA : Batteries.RBSet AccountAddress compare) (σ : AccountMap)
    (target tmp0 tmp1 idx total n targetBase freePtr freePtr' inOffset copiedWord : UInt256)
    (rest : List UInt256) : Prop :=
  ∃ (cA' : Batteries.RBSet AccountAddress compare) (σ' : AccountMap)
    (z : Bool) (out : ByteArray) (A_in : Substate) (callGas : UInt256) (_kPost _CPost : ℕ),
    (∃ (g'' : UInt256) (A' : Substate),
      (cA', σ', g'', A', z, out) = Ethereum.EVM.Θ ee.blobVersionedHashes cA
        s0.genesisBlockHeader s0.blocks σ s0.σ₀ A_in
        (AccountAddress.ofUInt256 (UInt256.ofNat ee.codeOwner)) ee.sender
        (AccountAddress.ofUInt256 target) (toExecute σ (AccountAddress.ofUInt256 target))
        callGas (UInt256.ofNat ee.gasPrice) ⟨0⟩ ⟨0⟩
        ((collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord).readWithPadding
          inOffset.toNat (UInt256.sub (freePtr' + (⟨32⟩ : UInt256)) inOffset).toNat)
        (ee.depth + 1) ee.header ee.perm)
    ∧ out.size < UInt256.size
    ∧ RD retdataLoopBytecode ee g s0 collectPostCallPc
        ((if z then ⟨1⟩ else ⟨0⟩) :: tmp0 :: tmp1 :: idx :: total :: n ::
          targetBase :: rest)
        (out.write 0
          (collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord)
          inOffset.toNat (min (⟨0⟩ : UInt256) (UInt256.ofNat out.size)).toNat)
        (UInt256.ofNat
          (MachineState.M
            (MachineState.M awCallLoad.toNat inOffset.toNat
              (UInt256.sub (freePtr' + (⟨32⟩ : UInt256)) inOffset).toNat)
            inOffset.toNat (⟨0⟩ : UInt256).toNat))
        out (cA', σ') _kPost _CPost

