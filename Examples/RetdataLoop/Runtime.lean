def collectReturndataMem (mem : ByteArray) (ptr : UInt256) (out : ByteArray) : ByteArray :=
  collectReturndataCopyMem
    (collectReturndataLenMem (collectReturndataPtrMem mem ptr out) ptr out)
    ptr out

theorem collectReturndataLenMem_read_len {mem out : ByteArray} {ptr : UInt256}
    (hgap : ptr.toNat - mem.size < USize.size) :
    (collectReturndataLenMem mem ptr out).readWithPadding ptr.toNat 32 =
      UInt256.toByteArray (UInt256.ofNat out.size) := by
  unfold collectReturndataLenMem
