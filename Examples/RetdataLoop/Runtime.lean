    exact UInt256.toNat_ofNat_of_lt (nat_lt_size_of_mul32_lt hMFit)
  rw [hToNat]
  exact hMFit

theorem collectPostCallSuccessAwJoinLen_fit_of_copy_fit
    {freePtr ptr awCopy awJoinLen : UInt256}
    (hawCopyFit : awCopy.toNat * 32 < UInt256.size)
    (hptr : ptr = collectPackedDataEnd freePtr)
    (hfitNextAw : freePtr.toNat + 192 < UInt256.size)
    (hawJoinLen : UInt256.ofNat (MachineState.M awCopy.toNat ptr.toNat 32) =
      awJoinLen) :
    awJoinLen.toNat * 32 < UInt256.size := by
  have hptrToNat : ptr.toNat = freePtr.toNat + 64 := by
    rw [hptr]
    exact collectPackedDataEnd_toNat (by omega)
  have hMFit :
      MachineState.M awCopy.toNat ptr.toNat 32 * 32 < UInt256.size :=
    machineState_M_mul32_lt_of_bounds
      (s := awCopy.toNat) (f := ptr.toNat) (l := 32)
      hawCopyFit (by
        rw [hptrToNat]
        omega)
  have hToNat :
      awJoinLen.toNat = MachineState.M awCopy.toNat ptr.toNat 32 := by
    rw [← hawJoinLen]
    exact UInt256.toNat_ofNat_of_lt (nat_lt_size_of_mul32_lt hMFit)
  rw [hToNat]
  exact hMFit

theorem collectPostCallSuccessAwRead_fit
    {freePtr ptr aw awLoad awStorePtr awStoreLen awCopy awJoinLen awDecodeLen awRead : UInt256}
    {out : ByteArray}
    (hawFit : aw.toNat * 32 < UInt256.size)
    (hptr : ptr = collectPackedDataEnd freePtr)
    (hout : out.size = 32)
    (hfitNextAw : freePtr.toNat + 192 < UInt256.size)
    (hawLoad : UInt256.ofNat (MachineState.M aw.toNat (⟨64⟩ : UInt256).toNat 32) =
      awLoad)
    (hawStorePtr :
      UInt256.ofNat (MachineState.M awLoad.toNat (⟨64⟩ : UInt256).toNat 32) =
        awStorePtr)
    (hawStoreLen :
      UInt256.ofNat (MachineState.M awStorePtr.toNat ptr.toNat 32) = awStoreLen)
    (hawCopy :
      UInt256.ofNat
        (MachineState.M awStoreLen.toNat (ptr + ⟨32⟩).toNat
          (UInt256.ofNat out.size).toNat) = awCopy)
    (hawJoinLen : UInt256.ofNat (MachineState.M awCopy.toNat ptr.toNat 32) = awJoinLen)
    (hawDecodeLen : UInt256.ofNat (MachineState.M awJoinLen.toNat ptr.toNat 32) =
      awDecodeLen)
    (hawRead :
      UInt256.ofNat
        (MachineState.M awDecodeLen.toNat (collectDecodeWordOffset ptr).toNat 32) =
        awRead) :
    awRead.toNat * 32 < UInt256.size := by
  have hawLoadFit := collectPostCallSuccessAwLoad_fit hawFit hawLoad
  have hawStorePtrFit := collectPostCallSuccessAwStorePtr_fit hawLoadFit hawStorePtr
  have hawStoreLenFit :=
    collectPostCallSuccessAwStoreLen_fit hawStorePtrFit hptr hfitNextAw hawStoreLen
  have hptrToNat : ptr.toNat = freePtr.toNat + 64 := by
    rw [hptr]
    exact collectPackedDataEnd_toNat (by omega)
  have hptrAddToNat : (ptr + (⟨32⟩ : UInt256)).toNat = freePtr.toNat + 96 := by
    have hadd : (ptr + (⟨32⟩ : UInt256)).toNat = ptr.toNat + 32 :=
      uadd_word_lit32_toNat ptr (by
        rw [hptrToNat]
        omega)
    rw [hadd, hptrToNat]
  have houtToNat : (UInt256.ofNat out.size).toNat = 32 := by
    rw [hout]
    exact UInt256.toNat_ofNat_of_lt (by native_decide : 32 < UInt256.size)
  have hcopyFl :
      (ptr + ⟨32⟩).toNat + (UInt256.ofNat out.size).toNat + 31 < UInt256.size := by
    rw [hptrAddToNat, houtToNat]
    omega
  have hawCopyFit :=
    collectPostCallSuccessAwCopy_fit_of_bounds
      (hawStoreLenFit := hawStoreLenFit)
      (hfl := hcopyFl)
      (hawCopy := hawCopy)
  have hawJoinLenFit :=
    collectPostCallSuccessAwJoinLen_fit_of_copy_fit hawCopyFit hptr hfitNextAw hawJoinLen
  have hawDecodeLenFit :=
    collectPostCallSuccessAwDecodeLen_fit_of_joinLen_fit hawJoinLenFit hptr hfitNextAw
      hawDecodeLen
  exact collectPostCallSuccessAwRead_fit_of_decodeLen_fit hawDecodeLenFit hptr hfitNextAw
    hawRead

theorem collectReturndataMem_mload_decode_word_of_size_32
    {mem out : ByteArray} {aw ptr : UInt256}
    (hout : out.size = 32)
    (hcopyDest :
      (ptr + ⟨32⟩).toNat ≤
        (collectReturndataLenMem (collectReturndataPtrMem mem ptr out) ptr out).size)
    (hmemOk : ¬ (collectDecodeWordOffset ptr).toNat ≥
        (collectReturndataMem mem ptr out).size)
    (hawOk : ¬ collectDecodeWordOffset ptr ≥ aw * ⟨32⟩) :
    (if (collectDecodeWordOffset ptr).toNat ≥
          (collectReturndataMem mem ptr out).size ∨
        collectDecodeWordOffset ptr ≥ aw * ⟨32⟩ then ⟨0⟩
     else UInt256.ofNat
        (fromByteArrayBigEndian
          ((collectReturndataMem mem ptr out).readWithPadding
            (collectDecodeWordOffset ptr).toNat 32))) =
      UInt256.ofNat (fromByteArrayBigEndian (out.extract 0 32)) := by
  rw [if_neg (not_or.mpr ⟨hmemOk, hawOk⟩)]
  rw [collectDecodeWordOffset_eq_add32]
  unfold collectReturndataMem
  unfold collectReturndataCopyMem
  have hlt : out.size < UInt256.size := by
    rw [hout]
    native_decide
  have hlen : (UInt256.ofNat out.size).toNat = 32 := by
    rw [UInt256.toNat_ofNat_of_lt hlt, hout]
  rw [hlen]
  rw [write32_read_back out
    (collectReturndataLenMem (collectReturndataPtrMem mem ptr out) ptr out)
    (ptr + ⟨32⟩).toNat (by rw [hout]) hcopyDest]

def collectCalldataWord (ee : ExecutionEnv) (off : UInt256) : UInt256 :=
  uInt256OfByteArray (ee.calldata.readBytes off.toNat 32)

def collectTargetSlot (idx targetBase : UInt256) : UInt256 :=
  (UInt256.mul (⟨32⟩ : UInt256) idx) + targetBase

def collectTargetEnd (idx targetBase : UInt256) : UInt256 :=
  collectTargetSlot idx targetBase + ⟨32⟩

def collectTargetWord (ee : ExecutionEnv) (idx targetBase : UInt256) : UInt256 :=
  collectCalldataWord ee (collectTargetSlot idx targetBase + ⟨0⟩)

theorem collectReadNat_calldataWord_eq_of_toNat
    {I : ExecutionEnv} {headOff n : Nat} {offWord : UInt256}
    (hoffWord : offWord.toNat = 4 + headOff)
    (hread : readNat? (List.drop 4 I.calldata.toList) headOff = some n) :
    collectCalldataWord I offWord = UInt256.ofNat n := by
  have hreadLen := readNat?_some_length hread
  have htlen : I.calldata.toList.length = I.calldata.size := by
    rw [byteArray_toList_eq, Array.length_toList]
    rfl
  have hsz : 4 + headOff + 32 ≤ I.calldata.size := by
    rw [List.length_drop, htlen] at hreadLen
    omega
  unfold collectCalldataWord
  rw [hoffWord]
  rw [← decode_word_at_eq_any I.calldata (4 + headOff) hsz]
  have hword := readNat?_some_bytesToWord hread
  simpa [List.drop_drop, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hword

theorem collectTargetWord_eq_of_readNat
    {I : ExecutionEnv} {idx targetBase : UInt256} {headOff : Nat} {value : UInt256}
    (hslot : (collectTargetSlot idx targetBase + ⟨0⟩).toNat = 4 + headOff)
    (hread : readNat? (List.drop 4 I.calldata.toList) headOff = some value.toNat) :
    collectTargetWord I idx targetBase = value := by
  have hword := collectReadNat_calldataWord_eq_of_toNat
    (I := I) (headOff := headOff) (n := value.toNat)
    (offWord := collectTargetSlot idx targetBase + ⟨0⟩) hslot hread
  simpa [collectTargetWord, u256_ofNat_toNat] using hword

theorem collectArgsDecodeHelper_success_of_readNat {g : Sat256} {s0 : State}
    {I : ExecutionEnv} {k C : ℕ} {off len : Nat}
    {R : List UInt256} {mem : ByteArray} {aw : UInt256} {rdata : ByteArray}
    {acc : Batteries.RBSet AccountAddress compare × AccountMap} {ret : UInt256}
    (rd : RD retdataLoopBytecode I g s0 collectArgsDecodeHelperPc
        ((⟨4⟩ : UInt256) :: UInt256.ofNat I.calldata.size :: ret :: R)
        mem aw rdata acc k C)
    (hsize : I.calldata.size < UInt256.size)
    (hsmall : I.calldata.size < 2 ^ 255)
    (hreadOff : readNat? (List.drop 4 I.calldata.toList) 0 = some off)
    (hoffMax : ¬ solcMaxU64 < off)
    (hreadLen : readNat? (List.drop 4 I.calldata.toList) off = some len)
    (hlenMax : ¬ solcMaxU64 < len)
    (hendNat : 4 + off + 32 + 32 * len ≤ I.calldata.size)
    (hret : (D_J retdataLoopBytecode 0).contains ret = true)
    (hov : R.length + 18 ≤ 1024) :
    ∃ k' C',
      RD retdataLoopBytecode I g s0 ret
        (UInt256.ofNat len :: (((⟨4⟩ : UInt256) + UInt256.ofNat off) + ⟨32⟩) :: R)
        mem aw rdata acc k' C' := by
  have hmaxLt : solcMaxU64 < UInt256.size := by
    norm_num [ABI.solcMaxU64, UInt256.size]
  have hoffLe : off ≤ solcMaxU64 := Nat.le_of_not_gt hoffMax
  have hlenLe : len ≤ solcMaxU64 := Nat.le_of_not_gt hlenMax
  have hoffLt : off < UInt256.size := lt_of_le_of_lt hoffLe hmaxLt
  have hlenLt : len < UInt256.size := lt_of_le_of_lt hlenLe hmaxLt
  have hmaxWord : (⟨18446744073709551615⟩ : UInt256).toNat = solcMaxU64 := by
    native_decide
  have hreadOffLen := readNat?_some_length hreadOff
  have hreadLenLen := readNat?_some_length hreadLen
  have htlen : I.calldata.toList.length = I.calldata.size := by
    rw [byteArray_toList_eq, Array.length_toList]
    rfl
  have hheadBytes : 36 ≤ I.calldata.size := by
    rw [List.length_drop, htlen] at hreadOffLen
    omega
  have hlenBytes : 4 + off + 32 ≤ I.calldata.size := by
    rw [List.length_drop, htlen] at hreadLenLen
    omega
  have hheadSub :
      (UInt256.sub (UInt256.ofNat I.calldata.size) (⟨4⟩ : UInt256)).toNat =
        I.calldata.size - 4 := by
    exact usub_ofNat_lit_toNat (n := I.calldata.size) (c := 4) (by omega) hsize
  have hheadSlt :
      UInt256.slt (UInt256.sub (UInt256.ofNat I.calldata.size) (⟨4⟩ : UInt256)) ⟨32⟩ =
        ⟨0⟩ := by
    apply slt_lit_zero (m := 32)
    · norm_num
    · rw [hheadSub]
      omega
    · rw [hheadSub]
      omega
  have hhead :
      UInt256.isZero
          (UInt256.slt (UInt256.sub (UInt256.ofNat I.calldata.size) (⟨4⟩ : UInt256)) ⟨32⟩) ≠
        ⟨0⟩ := by
    rw [hheadSlt]
    decide
  have hloadHead :
      uInt256OfByteArray
          (I.calldata.readBytes (((⟨4⟩ : UInt256) + (⟨0⟩ : UInt256)).toNat) 32) =
        UInt256.ofNat off := by
    have hzero : (((⟨4⟩ : UInt256) + (⟨0⟩ : UInt256)).toNat = 4 + 0) := by
      native_decide
    simpa [collectCalldataWord] using
      collectReadNat_calldataWord_eq_of_toNat
        (I := I) (headOff := 0) (n := off)
        (offWord := (⟨4⟩ : UInt256) + (⟨0⟩ : UInt256)) hzero hreadOff
  have hoffWordMax :
      UInt256.gt (UInt256.ofNat off) ⟨18446744073709551615⟩ = ⟨0⟩ := by
    apply ugt_zero
    rw [UInt256.toNat_ofNat_of_lt hoffLt, hmaxWord]
    exact hoffLe
  have hbaseToNat : (((⟨4⟩ : UInt256) + UInt256.ofNat off).toNat = 4 + off) := by
    rw [uadd_toNat, show (⟨4⟩ : UInt256).toNat = 4 from by decide,
      UInt256.toNat_ofNat_of_lt hoffLt]
    exact Nat.mod_eq_of_lt (by
      have : solcMaxU64 + 4 < UInt256.size := by
        norm_num [ABI.solcMaxU64, UInt256.size]
      omega)
  have hloadLen :
      uInt256OfByteArray
          (I.calldata.readBytes (((⟨4⟩ : UInt256) + UInt256.ofNat off).toNat) 32) =
        UInt256.ofNat len := by
    simpa [collectCalldataWord] using
      collectReadNat_calldataWord_eq_of_toNat
        (I := I) (headOff := off) (n := len)
        (offWord := (⟨4⟩ : UInt256) + UInt256.ofNat off) hbaseToNat hreadLen
  have hstartToNat :
      ((((⟨4⟩ : UInt256) + UInt256.ofNat off) + ⟨31⟩).toNat = 4 + off + 31) := by
    rw [uadd_toNat, hbaseToNat, show (⟨31⟩ : UInt256).toNat = 31 from by decide]
    exact Nat.mod_eq_of_lt (by
      have : solcMaxU64 + 35 < UInt256.size := by
        norm_num [ABI.solcMaxU64, UInt256.size]
      omega)
  have hstart :
      UInt256.slt (((⟨4⟩ : UInt256) + UInt256.ofNat off) + ⟨31⟩)
          (UInt256.ofNat I.calldata.size) =
        ⟨1⟩ := by
    apply slt_lit_one_low (m := I.calldata.size)
    · exact hsmall
    · rw [hstartToNat]
      omega
  have hlenWordMax :
      UInt256.gt (UInt256.ofNat len) ⟨18446744073709551615⟩ = ⟨0⟩ := by
    apply ugt_zero
    rw [UInt256.toNat_ofNat_of_lt hlenLt, hmaxWord]
    exact hlenLe
  have hmulToNat :
      (UInt256.mul (UInt256.ofNat len) (⟨32⟩ : UInt256)).toNat = len * 32 := by
    rw [u256_mul_toNat, UInt256.toNat_ofNat_of_lt hlenLt,
      show (⟨32⟩ : UInt256).toNat = 32 from by decide]
    exact Nat.mod_eq_of_lt (by
      have : solcMaxU64 * 32 < UInt256.size := by
        norm_num [ABI.solcMaxU64, UInt256.size]
      exact lt_of_le_of_lt (Nat.mul_le_mul_right 32 hlenLe) this)
  have hbase32ToNat :
      ((((⟨4⟩ : UInt256) + UInt256.ofNat off) + ⟨32⟩).toNat = 4 + off + 32) := by
    rw [uadd_toNat, hbaseToNat, show (⟨32⟩ : UInt256).toNat = 32 from by decide]
    exact Nat.mod_eq_of_lt (by
      have : solcMaxU64 + 36 < UInt256.size := by
        norm_num [ABI.solcMaxU64, UInt256.size]
      omega)
  have hendToNat :
      (((((⟨4⟩ : UInt256) + UInt256.ofNat off) + ⟨32⟩) +
          UInt256.mul (UInt256.ofNat len) (⟨32⟩ : UInt256)).toNat =
        4 + off + 32 + len * 32) := by
    rw [uadd_toNat, hbase32ToNat, hmulToNat]
    exact Nat.mod_eq_of_lt (by
      have hlt : 4 + off + 32 + 32 * len < UInt256.size :=
        lt_of_le_of_lt hendNat hsize
      omega)
  have hend :
      UInt256.gt
          (((((⟨4⟩ : UInt256) + UInt256.ofNat off) + ⟨32⟩) +
            UInt256.mul (UInt256.ofNat len) (⟨32⟩ : UInt256)))
          (UInt256.ofNat I.calldata.size) =
        ⟨0⟩ := by
    apply ugt_zero
    rw [hendToNat, UInt256.toNat_ofNat_of_lt hsize]
    omega
  exact collectArgsDecodeHelper_success
    (g := g) (s0 := s0) (ee := I) (start := (⟨4⟩ : UInt256))
    (ennd := UInt256.ofNat I.calldata.size) (ret := ret)
    (off := UInt256.ofNat off) (len := UInt256.ofNat len) (R := R)
    rd hhead hloadHead hoffWordMax hstart hloadLen hlenWordMax hend hret hov

theorem collectTargetSlot_add_zero_toNat_of_base
    {idx targetBase : UInt256} {off i : Nat}
    (hidx : idx.toNat = i)
    (hbase : targetBase.toNat = 4 + off + 32)
    (hmulfit : 32 * i < UInt256.size)
    (hfit : 32 * i + (4 + off + 32) < UInt256.size) :
    (collectTargetSlot idx targetBase + ⟨0⟩).toNat =
      4 + (off + 32 + 32 * i) := by
  have hzero : collectTargetSlot idx targetBase + (⟨0⟩ : UInt256) =
      collectTargetSlot idx targetBase := by
    rw [u256_add_comm (collectTargetSlot idx targetBase) (⟨0⟩ : UInt256),
      u256_zero_add]
  have hmulNat : (UInt256.mul (⟨32⟩ : UInt256) idx).toNat = 32 * i := by
    rw [u256_mul_toNat, show (⟨32⟩ : UInt256).toNat = 32 from by decide, hidx,
      Nat.mod_eq_of_lt hmulfit]
  have haddfit :
      (UInt256.mul (⟨32⟩ : UInt256) idx).toNat + targetBase.toNat < UInt256.size := by
    rw [hmulNat, hbase]
    exact hfit
  rw [hzero]
  unfold collectTargetSlot
  rw [uadd_toNat, hmulNat, hbase, Nat.mod_eq_of_lt]
  · omega
  · exact hfit

def collectMaskedTarget (ee : ExecutionEnv) (idx targetBase : UInt256) : UInt256 :=
  UInt256.land solcAddrMask (collectTargetWord ee idx targetBase)

/-- The part of the `collect` loop stack observed by the loop guard.

At `0x63`, the generated guard duplicates the fourth and fourth-again stack entries, then compares
the original top entry against the original third entry. The sequence preserves the stack.
-/
def collectLoopStack (idx x1 n x3 : UInt256) (rest : List UInt256) : List UInt256 :=
  idx :: x1 :: n :: x3 :: rest

def collectCopyLoopTail (src dst target tmp0 tmp1 idx total n targetBase : UInt256)
    (rest : List UInt256) : List UInt256 :=
  (⟨32⟩ : UInt256) :: (⟨0⟩ : UInt256) :: src :: dst ::
    collectCallDataCopyReturnPc :: (⟨0⟩ : UInt256) :: dst :: src ::
    collectCallSetupPc :: target :: tmp0 :: tmp1 :: idx :: total :: n :: targetBase :: rest

def collectCopyLoopTailOfLen (len src dst target tmp0 tmp1 idx total n targetBase : UInt256)
    (rest : List UInt256) : List UInt256 :=
  len :: (⟨0⟩ : UInt256) :: src :: dst ::
    collectCallDataCopyReturnPc :: (⟨0⟩ : UInt256) :: dst :: src ::
    collectCallSetupPc :: target :: tmp0 :: tmp1 :: idx :: total :: n :: targetBase :: rest

def collectMemoryCopyLoopStack (src dst len target tmp0 tmp1 idx total n targetBase : UInt256)
    (rest : List UInt256) : List UInt256 :=
  (src + ⟨32⟩) :: dst :: len :: collectMemoryCopyReturnPc ::
    collectCopyLoopTailOfLen len src dst target tmp0 tmp1 idx total n targetBase rest

def collectCallDataCopyStack (dst src target tmp0 tmp1 idx total n targetBase : UInt256)
    (rest : List UInt256) : List UInt256 :=
  dst :: src :: collectCallSetupPc :: target :: tmp0 :: tmp1 ::
    idx :: total :: n :: targetBase :: rest

def collectCopyLenMloadStack (src dst target tmp0 tmp1 idx total n targetBase : UInt256)
    (rest : List UInt256) : List UInt256 :=
  src :: (⟨0⟩ : UInt256) :: src :: ⟨0x382⟩ :: (⟨0⟩ : UInt256) ::
    src :: dst :: collectCallDataCopyReturnPc :: (⟨0⟩ : UInt256) ::
    collectCallDataCopyStack dst src target tmp0 tmp1 idx total n targetBase rest

def collectCallSetupStack (dataEnd target tmp0 tmp1 idx total n targetBase : UInt256)
    (rest : List UInt256) : List UInt256 :=
  dataEnd :: target :: tmp0 :: tmp1 :: idx :: total :: n :: targetBase :: rest

theorem collectGasCall_to_postCall {ee : ExecutionEnv} {g : Sat256} {s0 : State}
    {mem : ByteArray} {aw : UInt256} {rdata : ByteArray}
    {cA : Batteries.RBSet AccountAddress compare} {σ : AccountMap} {k C : ℕ}
    {target inOffset inSize outOffset outSize tmp0 tmp1 : UInt256} {rest : List UInt256}
    (rd : RD retdataLoopBytecode ee g s0 collectCallGasPc
      (target :: (⟨0⟩ : UInt256) :: inOffset :: inSize :: outOffset :: outSize ::
        tmp0 :: tmp1 :: rest)
      mem aw rdata (cA, σ) k C)
    (hdepth : ee.depth.val < 1024)
    (hov : rest.length + 9 ≤ 1024) :
    ∃ (cA' : Batteries.RBSet AccountAddress compare) (σ' : AccountMap)
      (z : Bool) (out : ByteArray) (A_in : Substate) (callGas : UInt256) (k' C' : ℕ),
      (∃ (g'' : UInt256) (A' : Substate),
        (cA', σ', g'', A', z, out) = Ethereum.EVM.Θ ee.blobVersionedHashes cA
          s0.genesisBlockHeader s0.blocks σ s0.σ₀ A_in
          (AccountAddress.ofUInt256 (UInt256.ofNat ee.codeOwner)) ee.sender
          (AccountAddress.ofUInt256 target) (toExecute σ (AccountAddress.ofUInt256 target))
          callGas (UInt256.ofNat ee.gasPrice) ⟨0⟩ ⟨0⟩
          (mem.readWithPadding inOffset.toNat inSize.toNat)
          (ee.depth + 1) ee.header ee.perm)
      ∧ RD retdataLoopBytecode ee g s0 collectPostCallPc
          ((if z then ⟨1⟩ else ⟨0⟩) :: rest)
          (out.write 0 mem outOffset.toNat (min outSize (UInt256.ofNat out.size)).toNat)
          (UInt256.ofNat (MachineState.M (MachineState.M aw.toNat inOffset.toNat inSize.toNat)
            outOffset.toNat outSize.toNat))
          out (cA', σ') k' C'
      ∧ out.size < UInt256.size := by
  obtain ⟨gasArg, rdCall⟩ := RD.gas rd (by native_decide)
    (by simp only [List.length_cons]; omega)
  obtain ⟨cA', σ', z, out, A_in, callGas, k1, C1, hΘ, rdAfterCall, houtSize⟩ :=
    RD.call (pc := collectCallPc) (gasArg := gasArg) (target := target)
      (inOffset := inOffset) (inSize := inSize) (outOffset := outOffset)
      (outSize := outSize) (t := tmp0 :: tmp1 :: rest)
      rdCall (by native_decide) hdepth (by simp only [List.length_cons]; omega)
  have rdPost := evm_run rdAfterCall with [swap2, pop, pop]
  exact ⟨cA', σ', z, out, A_in, callGas, k1 + 1 + 1 + 1, C1 + 3 + 2 + 2,
    hΘ, by simpa [collectCallGasPc, collectCallPc, collectPostCallPc] using rdPost,
    houtSize⟩

theorem collectPostCall_nonempty_alloc_to_join {ee : ExecutionEnv} {g : Sat256} {s0 : State}
    {mem : ByteArray} {aw awLoad awStorePtr awStoreLen awCopy : UInt256}
    {rdata : ByteArray} {acc : Batteries.RBSet AccountAddress compare × AccountMap}
    {z ptr : UInt256} {rest : List UInt256} {k C : ℕ}
    {mcLoad mcStorePtr mcStoreLen mcCopy : ℕ}
    (rd : RD retdataLoopBytecode ee g s0 collectPostCallPc
      (z :: rest) mem aw rdata acc k C)
    (hfp :
      (if (⟨64⟩ : UInt256).toNat ≥ mem.size ∨ (⟨64⟩ : UInt256) ≥ aw * ⟨32⟩ then ⟨0⟩
       else UInt256.ofNat
          (fromByteArrayBigEndian (mem.readWithPadding (⟨64⟩ : UInt256).toNat 32))) = ptr)
    (hrdataNonempty : rdata.size ≠ 0)
    (hrdataSize : rdata.size < UInt256.size)
    (hmcLoad : ∀ s : State, s.machineState.activeWords = aw →
        s.machineState.stack =
