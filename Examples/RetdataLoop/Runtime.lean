  unfold collectLoopStack at rd ⊢
  have rd' := evm_run rd with [
    jumpdest, dup4, dup4, swap1, pop, dup2, lt, iszero, push2 ⟨0x164⟩,
    jumpiT (by rw [hlt]; decide) (by jump_dest) ]
  exact ⟨_, _, rd'⟩

