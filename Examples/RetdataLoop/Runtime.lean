def collectPackedCallSuccessHeaderResult
    (ee : ExecutionEnv) (g : Sat256) (s0 : State) (mem : ByteArray)
    (awCallLoad : UInt256)
    (cA : Batteries.RBSet AccountAddress compare) (σ : AccountMap)
    (target tmp0 tmp1 idx total n targetBase freePtr freePtr' inOffset copiedWord : UInt256)
    (rest : List UInt256) : Prop :=
  ∃ (cA' : Batteries.RBSet AccountAddress compare) (σ' : AccountMap)
    (z : Bool) (out : ByteArray) (A_in : Substate) (callGas : UInt256) (_kPost _CPost : ℕ),
    (∃ (g'' : UInt256) (A' : Substate),
      (cA', σ', g'', A', z, out) = Ethereum.EVM.Θ ee.blobVersionedHashes cA
        s0.genesisBlockHeader s0.blocks σ s0.σ₀ A_in
        (AccountAddress.ofUInt256 (UInt256.ofNat ee.codeOwner)) ee.sender
        (AccountAddress.ofUInt256 target) (toExecute σ (AccountAddress.ofUInt256 target))
        callGas (UInt256.ofNat ee.gasPrice) ⟨0⟩ ⟨0⟩
        ((collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord).readWithPadding
          inOffset.toNat (UInt256.sub (freePtr' + (⟨32⟩ : UInt256)) inOffset).toNat)
        (ee.depth + 1) ee.header ee.perm)
    ∧ out.size < UInt256.size
    ∧ ∀ {ptr value postAwLoad postAwStorePtr postAwStoreLen postAwCopy
          postAwJoinLen postAwDecodeLen postAwRead : UInt256}
        {postMcLoad postMcStorePtr postMcStoreLen postMcCopy
          postMcJoinLen postMcDecodeLen postMcRead : ℕ},
      z = true →
      out.size = 32 →
      (if (⟨64⟩ : UInt256).toNat ≥
            (collectZeroOutCallMem
              (collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord)
              out inOffset).size ∨
          (⟨64⟩ : UInt256) ≥
            (UInt256.ofNat
              (MachineState.M
                (MachineState.M awCallLoad.toNat inOffset.toNat
                  (UInt256.sub (freePtr' + (⟨32⟩ : UInt256)) inOffset).toNat)
                inOffset.toNat (⟨0⟩ : UInt256).toNat)) * ⟨32⟩ then ⟨0⟩
       else UInt256.ofNat
          (fromByteArrayBigEndian
            ((collectZeroOutCallMem
              (collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord)
              out inOffset).readWithPadding (⟨64⟩ : UInt256).toNat 32))) = ptr →
      (∀ s : State,
        s.machineState.activeWords =
            UInt256.ofNat
              (MachineState.M
                (MachineState.M awCallLoad.toNat inOffset.toNat
                  (UInt256.sub (freePtr' + (⟨32⟩ : UInt256)) inOffset).toNat)
                inOffset.toNat (⟨0⟩ : UInt256).toNat) →
        s.machineState.stack =
          (⟨64⟩ : UInt256) :: UInt256.ofNat out.size :: UInt256.ofNat out.size ::
            (⟨1⟩ : UInt256) :: tmp0 :: tmp1 :: idx :: total :: n :: targetBase :: rest →
        memoryExpansionCost s .MLOAD = postMcLoad) →
      UInt256.ofNat
          (MachineState.M
            (UInt256.ofNat
              (MachineState.M
                (MachineState.M awCallLoad.toNat inOffset.toNat
                  (UInt256.sub (freePtr' + (⟨32⟩ : UInt256)) inOffset).toNat)
                inOffset.toNat (⟨0⟩ : UInt256).toNat)).toNat
            (⟨64⟩ : UInt256).toNat 32) = postAwLoad →
      (∀ s : State, s.machineState.activeWords = postAwLoad →
        s.machineState.stack =
          (⟨64⟩ : UInt256) :: (ptr + collectRoundedReturndataSize out) ::
            UInt256.ofNat out.size :: ptr :: (⟨1⟩ : UInt256) ::
            tmp0 :: tmp1 :: idx :: total :: n :: targetBase :: rest →
        memoryExpansionCost s .MSTORE = postMcStorePtr) →
      UInt256.ofNat (MachineState.M postAwLoad.toNat (⟨64⟩ : UInt256).toNat 32) =
        postAwStorePtr →
      (∀ s : State, s.machineState.activeWords = postAwStorePtr →
        s.machineState.stack =
          ptr :: UInt256.ofNat out.size :: UInt256.ofNat out.size :: ptr ::
            (⟨1⟩ : UInt256) :: tmp0 :: tmp1 :: idx :: total :: n :: targetBase :: rest →
        memoryExpansionCost s .MSTORE = postMcStoreLen) →
      UInt256.ofNat (MachineState.M postAwStorePtr.toNat ptr.toNat 32) =
        postAwStoreLen →
      (∀ s : State, s.machineState.activeWords = postAwStoreLen →
        s.machineState.stack =
          (ptr + ⟨32⟩) :: (⟨0⟩ : UInt256) :: UInt256.ofNat out.size ::
            UInt256.ofNat out.size :: ptr :: (⟨1⟩ : UInt256) ::
            tmp0 :: tmp1 :: idx :: total :: n :: targetBase :: rest →
        memoryExpansionCost s .RETURNDATACOPY = postMcCopy) →
      UInt256.ofNat
        (MachineState.M postAwStoreLen.toNat (ptr + ⟨32⟩).toNat
          (UInt256.ofNat out.size).toNat) = postAwCopy →
      (if ptr.toNat ≥
            (collectReturndataMem
              (collectZeroOutCallMem
                (collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord)
                out inOffset)
              ptr out).size ∨
          ptr ≥ postAwCopy * ⟨32⟩ then ⟨0⟩
       else UInt256.ofNat
          (fromByteArrayBigEndian
            ((collectReturndataMem
              (collectZeroOutCallMem
                (collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord)
                out inOffset)
              ptr out).readWithPadding ptr.toNat 32))) = ⟨32⟩ →
      (∀ s : State, s.machineState.activeWords = postAwCopy →
        s.machineState.stack = ptr :: (⟨32⟩ : UInt256) ::
          ptr :: (⟨1⟩ : UInt256) :: idx :: total :: n :: targetBase :: rest →
        memoryExpansionCost s .MLOAD = postMcJoinLen) →
      UInt256.ofNat (MachineState.M postAwCopy.toNat ptr.toNat 32) = postAwJoinLen →
      (if ptr.toNat ≥
            (collectReturndataMem
              (collectZeroOutCallMem
                (collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord)
                out inOffset)
              ptr out).size ∨
          ptr ≥ postAwJoinLen * ⟨32⟩ then ⟨0⟩
       else UInt256.ofNat
          (fromByteArrayBigEndian
            ((collectReturndataMem
              (collectZeroOutCallMem
                (collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord)
                out inOffset)
              ptr out).readWithPadding ptr.toNat 32))) = ⟨32⟩ →
      (∀ s : State, s.machineState.activeWords = postAwJoinLen →
        s.machineState.stack =
          ptr :: ((⟨32⟩ : UInt256) + ptr) :: ptr ::
            (⟨1⟩ : UInt256) :: idx :: total :: n :: targetBase :: rest →
        memoryExpansionCost s .MLOAD = postMcDecodeLen) →
      UInt256.ofNat (MachineState.M postAwJoinLen.toNat ptr.toNat 32) =
        postAwDecodeLen →
      UInt256.isZero
          (UInt256.slt
            (UInt256.sub (collectDecodeDataEnd ptr) (collectDecodeDataStart ptr))
            ⟨32⟩) ≠ ⟨0⟩ →
      (if (collectDecodeWordOffset ptr).toNat ≥
            (collectReturndataMem
              (collectZeroOutCallMem
                (collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord)
                out inOffset)
              ptr out).size ∨
          collectDecodeWordOffset ptr ≥ postAwDecodeLen * ⟨32⟩ then ⟨0⟩
       else UInt256.ofNat
          (fromByteArrayBigEndian
            ((collectReturndataMem
              (collectZeroOutCallMem
                (collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord)
                out inOffset)
              ptr out).readWithPadding (collectDecodeWordOffset ptr).toNat 32))) =
        value →
      (∀ s : State, s.machineState.activeWords = postAwDecodeLen →
        s.machineState.stack =
          collectDecodeWordOffset ptr :: (⟨0⟩ : UInt256) ::
            collectDecodeWordOffset ptr ::
            collectDecodeDataEnd ptr ::
            collectUint256MemoryReadReturnPc :: (⟨0⟩ : UInt256) ::
            (⟨0⟩ : UInt256) :: collectDecodeDataStart ptr ::
            collectDecodeDataEnd ptr :: collectAfterDecodePc :: ptr ::
            (⟨1⟩ : UInt256) :: idx :: total :: n :: targetBase :: rest →
        memoryExpansionCost s .MLOAD = postMcRead) →
      UInt256.ofNat
        (MachineState.M postAwDecodeLen.toNat (collectDecodeWordOffset ptr).toNat 32) =
        postAwRead →
      total.toNat + value.toNat < UInt256.size →
      idx.toNat + 1 < UInt256.size →
      ∃ k' C',
        RD retdataLoopBytecode ee g s0 collectLoopHeaderPc
          (collectLoopStack (idx + ⟨1⟩) (total + value) n targetBase rest)
          (collectReturndataMem
            (collectZeroOutCallMem
              (collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord)
              out inOffset)
            ptr out)
          postAwRead out (cA', σ') k' C'

theorem collectPackedCallSuccessHeaderResult_callViaEVM {evm : EVM.State}
    {ee : ExecutionEnv} {g : Sat256} {s0 : State} {mem : ByteArray}
    {awCallLoad : UInt256}
    {cA : Batteries.RBSet AccountAddress compare} {σ : AccountMap}
    {target tmp0 tmp1 idx total n targetBase freePtr freePtr' inOffset copiedWord : UInt256}
    {rest : List UInt256}
    (hres :
      collectPackedCallSuccessHeaderResult ee g s0 mem awCallLoad cA σ target tmp0 tmp1
        idx total n targetBase freePtr freePtr' inOffset copiedWord rest)
    (hEnv : evm.executionEnv = ee)
    (hCreated : evm.createdAccounts = cA)
    (hGenesis : evm.genesisBlockHeader = s0.genesisBlockHeader)
    (hBlocks : evm.blocks = s0.blocks)
    (hMap : evm.accountMap = σ)
    (hOrig : evm.σ₀ = s0.σ₀)
    (hperm : ee.perm = true)
    (hdepth : ee.depth.val < 1024) :
    ∃ (cA' : Batteries.RBSet AccountAddress compare) (σ' : AccountMap)
      (z : Bool) (out : ByteArray) (A' : Substate) (evm' : EVM.State),
      callViaEVM evm (AccountAddress.ofUInt256 target) 0
        ((collectCopiedPackedCallMem mem freePtr idx freePtr' copiedWord).readWithPadding
          inOffset.toNat (UInt256.sub (freePtr' + (⟨32⟩ : UInt256)) inOffset).toNat)
        (z, evm', out)
      ∧ evm' = { evm with accountMap := σ', substate := A', createdAccounts := cA' }
      ∧ out.size < UInt256.size := by
  obtain ⟨cA', σ', z, out, A_in, callGas, _kPost, _CPost, hΘ, houtLt, _hcont⟩ := hres
  obtain ⟨g'', A', hΘEq⟩ := hΘ
  let evm' : EVM.State := { evm with accountMap := σ', substate := A', createdAccounts := cA' }
  refine ⟨cA', σ', z, out, A', evm', ?_, rfl, houtLt⟩
  refine callViaEVM.callMade
    (valueWord := (⟨0⟩ : UInt256))
    (cA' := cA') (σ' := σ') (g' := g'') (A' := A')
    ?_ ?_ ?_ ?_ ?_
  · exact wordOfInt_zero.symm
  · refine ⟨callGas, A_in, ?_⟩
    rw [hEnv, hCreated, hGenesis, hBlocks, hMap, hOrig]
    simpa [accountAddress_roundtrip, hperm] using hΘEq
  · simp [evm']
  · show (⟨0⟩ : UInt256) ≤ _
    exact Fin.zero_le _
  · intro hdepthEq
    apply Nat.ne_of_lt hdepth
    exact congrArg Fin.val (by simpa [hEnv] using hdepthEq)

