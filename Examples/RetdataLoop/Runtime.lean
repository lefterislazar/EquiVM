    (ptr + ⟨32⟩).toNat ≤
      (collectReturndataLenMem mem ptr out).size := by
  unfold collectReturndataLenMem
  have hcover :=
    toByteArray_write_size_ge_off_add32 (UInt256.ofNat out.size) mem ptr.toNat hgap
  have hptr :
      (ptr + (⟨32⟩ : UInt256)).toNat = ptr.toNat + 32 :=
    uadd_word_lit32_toNat ptr hptrAdd
  rw [hptr]
  exact hcover

theorem byteArray_write_cover_of_dest_le {src base : ByteArray} {dest len : ℕ}
    (hlen : len ≠ 0)
    (hsrc : len ≤ src.size)
    (hdest : dest ≤ base.size) :
    dest + len ≤ (src.write 0 base dest len).size := by
  by_cases hin : dest + len ≤ base.size
  · rw [write_eq_gen src base dest len hlen hsrc hin]
    rw [ByteArray.size_append, ByteArray.size_append, ByteArray.size_extract,
      ByteArray.size_extract, ByteArray.size_extract]
    omega
  · have hext : base.size < dest + len := by omega
    rw [write_eq_gen_extend src base dest len hlen hsrc hdest hext]
    rw [ByteArray.size_append, ByteArray.size_extract, ByteArray.size_extract]
    omega

theorem collectReturndataCopyMem_cover_of_size_32 {mem out : ByteArray} {ptr : UInt256}
    (hout : out.size = 32)
    (hcopyDest :
      (ptr + ⟨32⟩).toNat ≤ mem.size) :
    (ptr + ⟨32⟩).toNat + 32 ≤
      (collectReturndataCopyMem mem ptr out).size := by
  unfold collectReturndataCopyMem
  have hlen : (UInt256.ofNat out.size).toNat = 32 := by
    rw [hout]
    native_decide
  rw [hlen]
  exact byteArray_write_cover_of_dest_le
    (src := out) (base := mem) (dest := (ptr + ⟨32⟩).toNat) (len := 32)
    (by decide) (by rw [hout]) hcopyDest

theorem collectReturndataMem_mload_len {mem out : ByteArray} {aw ptr : UInt256}
    (houtNonempty : out.size ≠ 0)
    (houtLt : out.size < UInt256.size)
    (hptrAdd : ptr.toNat + 32 < UInt256.size)
    (hgapLen : ptr.toNat - (collectReturndataPtrMem mem ptr out).size < USize.size)
    (hcopyDest :
      (ptr + ⟨32⟩).toNat ≤
        (collectReturndataLenMem (collectReturndataPtrMem mem ptr out) ptr out).size)
    (hmemOk : ¬ ptr.toNat ≥ (collectReturndataMem mem ptr out).size)
    (hawOk : ¬ ptr ≥ aw * ⟨32⟩) :
    (if ptr.toNat ≥ (collectReturndataMem mem ptr out).size ∨
        ptr ≥ aw * ⟨32⟩ then ⟨0⟩
     else UInt256.ofNat
        (fromByteArrayBigEndian
          ((collectReturndataMem mem ptr out).readWithPadding ptr.toNat 32))) =
      UInt256.ofNat out.size := by
  rw [if_neg (not_or.mpr ⟨hmemOk, hawOk⟩)]
  unfold collectReturndataMem collectReturndataCopyMem
  have hlen : (UInt256.ofNat out.size).toNat = out.size :=
    UInt256.toNat_ofNat_of_lt houtLt
  rw [hlen]
  rw [write_read_below_gen_extend out
    (collectReturndataLenMem (collectReturndataPtrMem mem ptr out) ptr out)
    (ptr + ⟨32⟩).toNat out.size ptr.toNat]
  · rw [collectReturndataLenMem_read_len hgapLen,
      fromByteArrayBigEndian_toByteArray, u256_ofNat_toNat]
  · exact houtNonempty
  · omega
  · exact hcopyDest
  · rw [uadd_word_lit32_toNat ptr hptrAdd]

theorem collectReturndataMem_read64_of_size_32 {mem out : ByteArray} {ptr : UInt256}
    (hout : out.size = 32)
    (hptr : 96 ≤ ptr.toNat)
    (hptrAdd : ptr.toNat + 32 < UInt256.size)
    (hgapPtr : 64 - mem.size < USize.size)
    (hptrMemSize : 96 ≤ (collectReturndataPtrMem mem ptr out).size)
    (hgapLen : ptr.toNat - (collectReturndataPtrMem mem ptr out).size < USize.size)
