      ∃ k' C', RD retdataLoopBytecode ee g s0 collectLoopBodyPc
        (stk a) (mem a) (aw a) rdata (acc a) k' C')
    (hbody : ∀ v a L evm, Inv (v + 1) a L evm → ∀ k C,
