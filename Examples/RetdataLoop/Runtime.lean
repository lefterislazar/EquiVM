theorem collectCoreInv_next_of_success {ee : ExecutionEnv} {s0 : State}
    {v : ℕ} {a : CollectLoopCarry} {L L2 : Store} {evm evm' : EVM.State}
    {out : ByteArray} {ptr postAwRead freePtr' inOffset copiedWord : UInt256}
    {cA' : Batteries.RBSet AccountAddress compare} {σ' : AccountMap} {A' : Substate}
    (hInv : collectCoreInv ee s0 (v + 1) a L evm)
    (hi :
      L2.get? "i" =
        some (.int (Int.ofNat a.idx.toNat + 1)))
    (hn :
      L2.get? "n" = some (.int (Int.ofNat a.bound.toNat)))
    (htotal :
      L2.get? "total" =
        some
          (.int
            (Int.ofNat
              (UInt256.ofNat
                (a.total.toNat + (collectSourceDecodedValue out).toNat)).toNat)))
    (hevm' : evm' = { evm with accountMap := σ', substate := A', createdAccounts := cA' })
    (hfitIdx : a.idx.toNat + 1 < UInt256.size)
    (hfitTotal :
      a.total.toNat + (collectSourceDecodedValue out).toNat < UInt256.size) :
    collectCoreInv ee s0 v
      (collectSuccessNextCarry a out ptr postAwRead cA' σ' freePtr' inOffset copiedWord)
      L2 evm' := by
  rcases hInv with
    ⟨_hiOld, _hnOld, _htotalOld, hvar, _hle, hEnv, hCreated, hGenesis, hBlocks, hMap, hOrig⟩
  unfold collectCoreInv collectSuccessNextCarry
  constructor
  · rw [int_ofNat_uadd_one_toNat hfitIdx]
    exact hi
  constructor
  · exact hn
  constructor
  · have htotalWord :
        (a.total + collectSourceDecodedValue out).toNat =
          a.total.toNat + (collectSourceDecodedValue out).toNat :=
      uadd_toNat_of_lt hfitTotal
    have hsum :
        (UInt256.ofNat
          (a.total.toNat + (collectSourceDecodedValue out).toNat)).toNat =
            a.total.toNat + (collectSourceDecodedValue out).toNat :=
      ulit_toNat' _ hfitTotal
    simpa [htotalWord, hsum] using htotal
  constructor
  · change (a.idx + (⟨1⟩ : UInt256)).toNat + v = a.bound.toNat
    rw [uadd_one_toNat_of_lt hfitIdx]
    omega
  constructor
  · change (a.idx + (⟨1⟩ : UInt256)).toNat ≤ a.bound.toNat
    rw [uadd_one_toNat_of_lt hfitIdx]
    omega
  subst evm'
  simp [hEnv, hGenesis, hBlocks, hOrig]

theorem collectCoreBody_hbody_of_success_step {ee : ExecutionEnv} {g : Sat256}
    {s0 : State}
    {v : ℕ} {a : CollectLoopCarry} {L L1 L2 : Store} {evm evm' : EVM.State}
    {out : ByteArray} {ptr postAwRead freePtr' inOffset copiedWord : UInt256}
    {cA' : Batteries.RBSet AccountAddress compare} {σ' : AccountMap} {A' : Substate}
    {k' C' : ℕ}
    (hInv : collectCoreInv ee s0 (v + 1) a L evm)
    (hbody :
      ExecBlock retdataLoopConfig { contract := contract, locals := L } evm
        collectLoopBody (.ok { contract := contract, locals := L1 } evm'))
    (hpost :
      ExecBlock retdataLoopConfig { contract := contract, locals := L1 } evm'
        collectLoopPost (.ok { contract := contract, locals := L2 } evm'))
