theorem collectReturnWordFromMem_dynamic {ee : ExecutionEnv} {g : Sat256} {s0 : State}
    {mem : ByteArray} {aw awLoad : UInt256}
    {rdata : ByteArray} {acc : Batteries.RBSet AccountAddress compare × AccountMap}
    {val ptr endPtr : UInt256} {rest : List UInt256} {k C : ℕ}
    {mcLoad mcReturn : ℕ}
    (rd : RD retdataLoopBytecode ee g s0 collectReturnWordFromMemPc
      (endPtr :: rest) mem aw rdata acc k C)
    (hmcLoad : ∀ s : State, s.machineState.activeWords = aw →
        s.machineState.stack =
          (⟨64⟩ : UInt256) :: endPtr :: rest →
        memoryExpansionCost s .MLOAD = mcLoad)
    (hload :
      (if (⟨64⟩ : UInt256).toNat ≥ mem.size ∨
          (⟨64⟩ : UInt256) ≥ aw * ⟨32⟩ then ⟨0⟩
       else UInt256.ofNat
          (fromByteArrayBigEndian (mem.readWithPadding (⟨64⟩ : UInt256).toNat 32))) = ptr)
    (hawLoad : UInt256.ofNat (MachineState.M aw.toNat (⟨64⟩ : UInt256).toNat 32) = awLoad)
    (hlen : (UInt256.sub endPtr ptr).toNat = 32)
    (hread : mem.readWithPadding ptr.toNat 32 = UInt256.toByteArray val)
    (hmcReturn : ∀ s : State, s.machineState.activeWords = awLoad →
        s.machineState.stack = ptr :: UInt256.sub endPtr ptr :: rest →
        memoryExpansionCost s .RETURN = mcReturn)
    (hov : rest.length + 3 ≤ 1024) :
    RDret retdataLoopBytecode g s0 acc (UInt256.toByteArray val) := by
  have rdPreLoad := evm_run rd with [
    jumpdest, push1 ⟨64⟩]
  have rdLoad := RD.mload mcLoad ptr awLoad rdPreLoad (by native_decide)
    hmcLoad hload hawLoad (by simp only [List.length_cons]; omega)
  exact evm_run rdLoad with [
    dup1, swap2, sub, swap1,
    raw ret mcReturn (UInt256.toByteArray val) (by native_decide) hmcReturn
      (by
        rw [hlen]
        exact hread)
      (by evm_ov)]

