/-- A more concrete RetdataLoop loop wrapper that discharges the bytecode guard obligations.

The remaining runtime obligation is the body simulation from `0x6f` through calldata construction,
the low-level call, dynamic returndata allocation/copy, `require(ok)`, the length check, uint256
decode, checked accumulation, loop increment, and back edge.
-/
theorem collectRuntimeLoop_stackShape_from_body_or_revert {ee : ExecutionEnv} {g : Sat256}
    {s0 : State} {rdata : ByteArray} {α : Type}
    (Inv : ℕ → α → Store → EVM.State → Prop)
    (idx bound x1 x3 : α → UInt256)
    (rest : α → List UInt256)
    (mem : α → ByteArray) (aw : α → UInt256)
    (acc : α → Batteries.RBSet AccountAddress compare × AccountMap)
    (hshape : ∀ v a L evm, Inv v a L evm →
      L.get? "i" = some (.int (Int.ofNat (idx a).toNat)) ∧
      L.get? "n" = some (.int (Int.ofNat (bound a).toNat)) ∧
      (idx a).toNat + v = (bound a).toNat ∧
      (idx a).toNat ≤ (bound a).toNat)
    (hov : ∀ a, (rest a).length + 6 ≤ 1024)
    (hbody : ∀ v a L evm, Inv (v + 1) a L evm → ∀ k C,
      RD retdataLoopBytecode ee g s0 collectLoopBodyPc
        (collectLoopStack (idx a) (x1 a) (bound a) (x3 a) (rest a))
        (mem a) (aw a) rdata (acc a) k C →
      (ExecBlock retdataLoopConfig { contract := contract, locals := L } evm
          collectLoopBody .reverted ∧
        RDrev retdataLoopBytecode g s0) ∨
      ∃ a' L1 evm1 L2 evm2 k' C',
        (ExecBlock retdataLoopConfig { contract := contract, locals := L } evm
            collectLoopBody
            (.ok { contract := contract, locals := L1 } evm1) ∨
          ExecBlock retdataLoopConfig { contract := contract, locals := L } evm
            collectLoopBody
            (.continue { contract := contract, locals := L1 } evm1)) ∧
        ExecBlock retdataLoopConfig { contract := contract, locals := L1 } evm1
          collectLoopPost
          (.ok { contract := contract, locals := L2 } evm2) ∧
        Inv v a' L2 evm2 ∧
        RD retdataLoopBytecode ee g s0 collectLoopHeaderPc
          (collectLoopStack (idx a') (x1 a') (bound a') (x3 a') (rest a'))
          (mem a') (aw a') rdata (acc a') k' C') :
    ∀ v a L evm, Inv v a L evm → ∀ k C,
      RD retdataLoopBytecode ee g s0 collectLoopHeaderPc
        (collectLoopStack (idx a) (x1 a) (bound a) (x3 a) (rest a))
        (mem a) (aw a) rdata (acc a) k C →
      (∃ a' L' evm' k' C',
        ExecForLoop retdataLoopConfig
          { contract := contract, locals := L } evm
          collectLoopCond collectLoopPost collectLoopBody
          (.ok { contract := contract, locals := L' } evm') ∧
        Inv 0 a' L' evm' ∧
        RD retdataLoopBytecode ee g s0 collectLoopExitPc
          (collectLoopStack (idx a') (x1 a') (bound a') (x3 a') (rest a'))
          (mem a') (aw a') rdata (acc a') k' C') ∨
      (ExecForLoop retdataLoopConfig
          { contract := contract, locals := L } evm
          collectLoopCond collectLoopPost collectLoopBody .reverted ∧
        RDrev retdataLoopBytecode g s0) := by
  refine collectRuntimeLoop_from_body_or_revert
    (Inv := Inv) (idx := idx) (n := bound)
    (stk := fun a => collectLoopStack (idx a) (x1 a) (bound a) (x3 a) (rest a))
    (mem := mem) (aw := aw) (acc := acc)
    (exitStk := fun a =>
      collectLoopStack (idx a) (x1 a) (bound a) (x3 a) (rest a))
    hshape ?_ ?_ hbody
  · intro a L evm hInv k C rd
    rcases hshape 0 a L evm hInv with ⟨_, _, hvar, _⟩
    exact collectLoopHeader_exit (idx := idx a) (x1 := x1 a)
      (n := bound a) (x3 := x3 a) (rest := rest a)
      (by omega) (hov a) rd
  · intro v a L evm hInv k C rd
    rcases hshape (v + 1) a L evm hInv with ⟨_, _, hvar, _⟩
    exact collectLoopHeader_enter (idx := idx a) (x1 := x1 a)
      (n := bound a) (x3 := x3 a) (rest := rest a)
      (by omega) (hov a) rd

