/-!
Concrete loop PCs for `collect` in `retdataLoopBytecode`.

The loop header is the `JUMPDEST` at `0x63`; if the guard is false, the conditional branch exits to
`0x164`; if the guard is true, execution falls through to `0x6f`, where the loop body begins.
-/

def collectLoopHeaderPc : UInt256 := ⟨0x63⟩
def collectLoopBodyPc : UInt256 := ⟨0x6f⟩
def collectAfterTargetLoadPc : UInt256 := ⟨0x98⟩
def collectLoopExitPc : UInt256 := ⟨0x164⟩
def collectTargetLoadHelperPc : UInt256 := ⟨0x2d7⟩
def collectAfterEncodePackedPc : UInt256 := ⟨0xbf⟩
def collectEncodePackedUintHelperPc : UInt256 := ⟨0x322⟩
def collectCallDataCopyHelperPc : UInt256 := ⟨0x3a8⟩
def collectMemoryCopyLoopPc : UInt256 := ⟨0x350⟩
def collectMemoryCopyReturnPc : UInt256 := ⟨0x39c⟩
def collectCallDataCopyReturnPc : UInt256 := ⟨0x3b3⟩
def collectCallSetupPc : UInt256 := ⟨0xdb⟩
def collectCallGasPc : UInt256 := ⟨0xe6⟩
def collectCallPc : UInt256 := ⟨0xe7⟩
def collectPostCallPc : UInt256 := ⟨0xeb⟩
def collectReturndataJoinPc : UInt256 := ⟨0x119⟩
def collectDecodeStartPc : UInt256 := ⟨0x134⟩
def collectAfterDecodePc : UInt256 := ⟨0x148⟩
def collectAfterAddPc : UInt256 := ⟨0x153⟩
def collectReturnEncodePc : UInt256 := ⟨0x47⟩
def collectReturnWordFromMemPc : UInt256 := ⟨0x54⟩
def collectReturnWordEncoderPc : UInt256 := ⟨0x237⟩
def collectReturnWordStorePc : UInt256 := ⟨0x228⟩
def collectReturnWordStoreReturnPc : UInt256 := ⟨0x231⟩
def collectArgsDecodeHelperPc : UInt256 := ⟨0x1d4⟩
def collectArrayDecodeHelperPc : UInt256 := ⟨0x17f⟩
def collectAfterArgsDecodePc : UInt256 := ⟨0x42⟩
def collectFunctionBodyPc : UInt256 := ⟨0x5d⟩
def collectUint256DecodeHelperPc : UInt256 := ⟨0x3e8⟩
def collectUint256MemoryReadPc : UInt256 := ⟨0x3d4⟩
def collectUint256MemoryReadReturnPc : UInt256 := ⟨0x40a⟩
