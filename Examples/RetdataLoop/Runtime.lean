       else UInt256.ofNat
          (fromByteArrayBigEndian (mem.readWithPadding (⟨64⟩ : UInt256).toNat 32))) = ptr)
    (hawLoad : UInt256.ofNat (MachineState.M aw.toNat (⟨64⟩ : UInt256).toNat 32) = awLoad)
    (hmcStore : ∀ s : State, s.machineState.activeWords = awLoad →
        s.machineState.stack =
          (ptr + (⟨0⟩ : UInt256)) :: val :: val :: (ptr + (⟨0⟩ : UInt256)) ::
            (⟨0x24a⟩ : UInt256) :: (ptr + ⟨32⟩) :: ptr :: val ::
            collectReturnWordFromMemPc :: rest →
        memoryExpansionCost s .MSTORE = mcStore)
    (hawStore :
      UInt256.ofNat (MachineState.M awLoad.toNat (ptr + (⟨0⟩ : UInt256)).toNat 32) =
        awStore)
    (hov : rest.length + 15 ≤ 1024) :
    ∃ k' C',
      RD retdataLoopBytecode ee g s0 collectReturnWordFromMemPc
        ((ptr + ⟨32⟩) :: rest)
        (collectEncodePackedUintMem mem ptr val) awStore rdata acc k' C' := by
  have rdPreLoad := evm_run rd with [jumpdest, push1 ⟨64⟩]
  have rdLoad := RD.mload mcLoad ptr awLoad rdPreLoad (by native_decide)
    hmcLoad hload hawLoad (by simp only [List.length_cons]; omega)
  have rdHelper := evm_run rdLoad with [
    push2 collectReturnWordFromMemPc, swap2, swap1, push2 collectReturnWordEncoderPc,
    jump (by jump_dest)]
  have rdPreStore := evm_run rdHelper with [
    jumpdest, push0, push1 ⟨32⟩, dup3, add, swap1, pop,
    push2 ⟨0x24a⟩, push0, dup4, add, dup5, push2 collectReturnWordStorePc,
    jump (by jump_dest),
    jumpdest, push2 collectReturnWordStoreReturnPc, dup2, push2 collectUint256ValidateCleanupPc,
    jump (by jump_dest),
    jumpdest, push0, dup2, swap1, pop, swap2, swap1, pop, jump (by jump_dest),
    jumpdest, dup3]
  let memStore := collectEncodePackedUintMem mem ptr val
  have rdStore := RD.mstore mcStore memStore awStore rdPreStore (by native_decide)
    (by
      intro s hs hstk
      exact hmcStore s hs (by simpa using hstk))
    (by
      have hptrZero : ptr + (⟨0⟩ : UInt256) = ptr := by
        rw [u256_add_comm ptr (⟨0⟩ : UInt256), u256_zero_add]
      simp [memStore, collectEncodePackedUintMem, hptrZero])
    hawStore (by simp only [List.length_cons]; omega)
  have rdRet := evm_run rdStore with [
    pop, pop, jump (by jump_dest),
    jumpdest, swap3, swap2, pop, pop, jump (by jump_dest)]
  exact ⟨_, _, by
    simpa [collectReturnEncodePc, collectReturnWordFromMemPc, collectReturnWordEncoderPc,
      collectReturnWordStorePc, collectReturnWordStoreReturnPc, memStore] using rdRet⟩

structure CollectReturnEncodeWitnesses (a : CollectLoopCarry) (rest : List UInt256) where
  ptr : UInt256
  awEncodeLoad : UInt256
  awStore : UInt256
  awReturnLoad : UInt256
  mcEncodeLoad : ℕ
  mcStore : ℕ
  mcReturnLoad : ℕ
  mcReturn : ℕ
  hmcEncodeLoad : ∀ s : State, s.machineState.activeWords = a.aw →
    s.machineState.stack = (⟨64⟩ : UInt256) :: a.total :: rest →
    memoryExpansionCost s .MLOAD = mcEncodeLoad
  hloadEncode :
    (if (⟨64⟩ : UInt256).toNat ≥ a.mem.size ∨
        (⟨64⟩ : UInt256) ≥ a.aw * ⟨32⟩ then ⟨0⟩
     else UInt256.ofNat
        (fromByteArrayBigEndian (a.mem.readWithPadding (⟨64⟩ : UInt256).toNat 32))) = ptr
  hawEncodeLoad :
    UInt256.ofNat (MachineState.M a.aw.toNat (⟨64⟩ : UInt256).toNat 32) = awEncodeLoad
  hmcStore : ∀ s : State, s.machineState.activeWords = awEncodeLoad →
    s.machineState.stack =
      (ptr + (⟨0⟩ : UInt256)) :: a.total :: a.total :: (ptr + (⟨0⟩ : UInt256)) ::
        (⟨0x24a⟩ : UInt256) :: (ptr + ⟨32⟩) :: ptr :: a.total ::
        collectReturnWordFromMemPc :: rest →
    memoryExpansionCost s .MSTORE = mcStore
  hawStore :
    UInt256.ofNat (MachineState.M awEncodeLoad.toNat (ptr + (⟨0⟩ : UInt256)).toNat 32) =
      awStore
  hmcReturnLoad : ∀ s : State, s.machineState.activeWords = awStore →
    s.machineState.stack = (⟨64⟩ : UInt256) :: (ptr + ⟨32⟩) :: rest →
    memoryExpansionCost s .MLOAD = mcReturnLoad
  hloadReturn :
    (if (⟨64⟩ : UInt256).toNat ≥
          (collectEncodePackedUintMem a.mem ptr a.total).size ∨
        (⟨64⟩ : UInt256) ≥ awStore * ⟨32⟩ then ⟨0⟩
     else UInt256.ofNat
        (fromByteArrayBigEndian
          ((collectEncodePackedUintMem a.mem ptr a.total).readWithPadding
            (⟨64⟩ : UInt256).toNat 32))) = ptr
  hawReturnLoad :
    UInt256.ofNat (MachineState.M awStore.toNat (⟨64⟩ : UInt256).toNat 32) =
      awReturnLoad
  hlen : (UInt256.sub (ptr + ⟨32⟩) ptr).toNat = 32
  hread :
    (collectEncodePackedUintMem a.mem ptr a.total).readWithPadding ptr.toNat 32 =
      UInt256.toByteArray a.total
  hmcReturn : ∀ s : State, s.machineState.activeWords = awReturnLoad →
    s.machineState.stack = ptr :: UInt256.sub (ptr + ⟨32⟩) ptr :: rest →
    memoryExpansionCost s .RETURN = mcReturn
  hovEncode : rest.length + 15 ≤ 1024
  hovReturn : rest.length + 3 ≤ 1024

structure CollectReturnEncodePackage (a : CollectLoopCarry) where
  rest : List UInt256
  hrest : a.rest = collectReturnEncodePc :: rest
  witnesses : CollectReturnEncodeWitnesses a rest

def collectReturnMcEncodeLoad (a : CollectLoopCarry) : ℕ :=
  Cₘ (collectReturnEncodeLoadAw a) - Cₘ a.aw

def collectReturnMcStore (a : CollectLoopCarry) : ℕ :=
  Cₘ (collectReturnStoreAw a) - Cₘ (collectReturnEncodeLoadAw a)

def collectReturnMcReturnLoad (a : CollectLoopCarry) : ℕ :=
  Cₘ (collectReturnLoadAw a) - Cₘ (collectReturnStoreAw a)

def collectReturnMcReturn (a : CollectLoopCarry) : ℕ :=
  Cₘ
    (UInt256.ofNat
      (MachineState.M (collectReturnLoadAw a).toNat a.freePtr.toNat
        (UInt256.sub (a.freePtr + ⟨32⟩) a.freePtr).toNat)) -
    Cₘ (collectReturnLoadAw a)

def collectReturnEncodeWitnesses_of_allocator_bounds {a : CollectLoopCarry}
    {rest : List UInt256}
    (halloc : collectFreePtrAllocatorInv a)
    (hmem96 : 96 ≤ a.mem.size)
    (hawEncodeOk : ¬ (⟨64⟩ : UInt256) ≥ a.aw * ⟨32⟩)
    (hawReturnOk : ¬ (⟨64⟩ : UInt256) ≥ collectReturnStoreAw a * ⟨32⟩)
    (hfitFreePtr32 : a.freePtr.toNat + 32 < UInt256.size)
    (hgapWrite : a.freePtr.toNat - a.mem.size < USize.size)
    (hovEncode : rest.length + 15 ≤ 1024)
    (hovReturn : rest.length + 3 ≤ 1024) :
    CollectReturnEncodeWitnesses a rest := by
  have hptrGe : 96 ≤ a.freePtr.toNat := by
    have hstride := halloc.1
    unfold collectFreePtrStrideInv at hstride
    rw [hstride]
    omega
  have hread64 : a.mem.readWithPadding 64 32 = UInt256.toByteArray a.freePtr := by
    simpa [collectFreePtrMemInv] using halloc.2
  have hload64 :
      (if (⟨64⟩ : UInt256).toNat ≥ a.mem.size ∨
          (⟨64⟩ : UInt256) ≥ a.aw * ⟨32⟩ then ⟨0⟩
       else UInt256.ofNat
          (fromByteArrayBigEndian
            (a.mem.readWithPadding (⟨64⟩ : UInt256).toNat 32))) =
        a.freePtr := by
    exact mloadWordValue_of_readWithPadding
      (mem := a.mem) (aw := a.aw) (off := (⟨64⟩ : UInt256))
      (v := a.freePtr)
      (by change 64 < a.mem.size; omega)
      hawEncodeOk
      (by simpa [show (⟨64⟩ : UInt256).toNat = 64 from by decide] using hread64)
  have hread64After :
      (collectEncodePackedUintMem a.mem a.freePtr a.total).readWithPadding 64 32 =
        UInt256.toByteArray a.freePtr := by
    unfold collectEncodePackedUintMem
    rw [toByteArray_write_read_below_of_gap
      a.total a.mem a.freePtr.toNat 64 (by omega) (by omega) hgapWrite]
    exact hread64
  have hmemAfter :
      64 < (collectEncodePackedUintMem a.mem a.freePtr a.total).size := by
    have hcover :=
      toByteArray_write_size_ge_off_add32 a.total a.mem a.freePtr.toNat hgapWrite
    unfold collectEncodePackedUintMem
    omega
  have hload64After :
      (if (⟨64⟩ : UInt256).toNat ≥
            (collectEncodePackedUintMem a.mem a.freePtr a.total).size ∨
          (⟨64⟩ : UInt256) ≥ collectReturnStoreAw a * ⟨32⟩ then ⟨0⟩
       else UInt256.ofNat
          (fromByteArrayBigEndian
            ((collectEncodePackedUintMem a.mem a.freePtr a.total).readWithPadding
              (⟨64⟩ : UInt256).toNat 32))) =
        a.freePtr := by
    exact mloadWordValue_of_readWithPadding
      (mem := collectEncodePackedUintMem a.mem a.freePtr a.total)
      (aw := collectReturnStoreAw a) (off := (⟨64⟩ : UInt256))
      (v := a.freePtr)
      (by simpa [show (⟨64⟩ : UInt256).toNat = 64 from by decide] using hmemAfter)
      hawReturnOk
      (by simpa [show (⟨64⟩ : UInt256).toNat = 64 from by decide] using hread64After)
  refine
    { ptr := a.freePtr
      awEncodeLoad := collectReturnEncodeLoadAw a
      awStore := collectReturnStoreAw a
      awReturnLoad := collectReturnLoadAw a
      mcEncodeLoad := collectReturnMcEncodeLoad a
      mcStore := collectReturnMcStore a
      mcReturnLoad := collectReturnMcReturnLoad a
      mcReturn := collectReturnMcReturn a
      hmcEncodeLoad := ?_
      hloadEncode := hload64
      hawEncodeLoad := by rfl
      hmcStore := ?_
      hawStore := by rfl
      hmcReturnLoad := ?_
      hloadReturn := hload64After
      hawReturnLoad := by rfl
      hlen := ?_
      hread := ?_
      hmcReturn := ?_
      hovEncode := hovEncode
      hovReturn := hovReturn }
  · intro s hs hstk
    simp only [collectReturnMcEncodeLoad, collectReturnEncodeLoadAw,
      memoryExpansionCost, memoryExpansionCost.μᵢ', hs, hstk,
      List.getElem!_cons_zero]
  · intro s hs hstk
    simp only [collectReturnMcStore, collectReturnStoreAw,
      collectReturnEncodeLoadAw, memoryExpansionCost, memoryExpansionCost.μᵢ',
      hs, hstk, List.getElem!_cons_zero]
  · intro s hs hstk
    simp only [collectReturnMcReturnLoad, collectReturnLoadAw,
      collectReturnStoreAw, memoryExpansionCost, memoryExpansionCost.μᵢ',
      hs, hstk, List.getElem!_cons_zero]
  · have hptrAdd :
        (a.freePtr + (⟨32⟩ : UInt256)).toNat = a.freePtr.toNat + 32 :=
      uadd_word_lit32_toNat a.freePtr hfitFreePtr32
    rw [usub_toNat]
    · rw [hptrAdd]
      omega
    · rw [hptrAdd]
      omega
  · exact collectEncodePackedUintMem_read hgapWrite
  · intro s hs hstk
    simp only [collectReturnMcReturn, collectReturnLoadAw,
      memoryExpansionCost, memoryExpansionCost.μᵢ', hs, hstk,
      List.getElem!_cons_zero, List.getElem!_cons_succ]

def collectReturnEncodeWitnesses_of_ready {a : CollectLoopCarry} {rest : List UInt256}
    (hready : collectReturnReadyInv a)
    (hovEncode : rest.length + 15 ≤ 1024)
    (hovReturn : rest.length + 3 ≤ 1024) :
    CollectReturnEncodeWitnesses a rest :=
  collectReturnEncodeWitnesses_of_allocator_bounds
    hready.1 hready.2.1.1 hready.2.2.1.1 hready.2.2.1.2 hready.2.2.2
    hready.2.1.2 hovEncode hovReturn

theorem collectInitialCarry_return_ready {bound targetBase sel : UInt256}
    {cA : Batteries.RBSet AccountAddress compare} {σ : AccountMap} :
    collectReturnReadyInv (collectInitialCarry bound targetBase sel cA σ) := by
  refine ⟨collectInitialCarry_freePtr_allocator, ?_, ?_, ?_⟩
  · unfold collectReturnMemoryInv collectInitialCarry
    constructor
    · rw [solcFreePtrMem_size]
    · rw [solcFreePtrMem_size]
      change (⟨128⟩ : UInt256).toNat - 96 < USize.size
      native_decide
  · unfold collectReturnAwOkInv collectReturnStoreAw collectReturnEncodeLoadAw
      collectInitialCarry
    change
      ¬ (⟨64⟩ : UInt256) ≥ UInt256.ofNat 3 * ⟨32⟩ ∧
      ¬ (⟨64⟩ : UInt256) ≥
        UInt256.ofNat
            (MachineState.M
              (UInt256.ofNat (MachineState.M (UInt256.ofNat 3).toNat
                (⟨64⟩ : UInt256).toNat 32)).toNat
              ((⟨128⟩ : UInt256) + (⟨0⟩ : UInt256)).toNat 32) *
          ⟨32⟩
    native_decide
  · unfold collectReturnFitInv collectInitialCarry
    change (⟨128⟩ : UInt256).toNat + 32 < UInt256.size
    native_decide

theorem collectReturnAwOkInv_of_aw_ge3_fit_freePtr63 {a : CollectLoopCarry}
    (haw : 3 ≤ a.aw.toNat)
    (hawFit : a.aw.toNat * 32 < UInt256.size)
    (hfreePtrFit : a.freePtr.toNat + 63 < UInt256.size) :
    collectReturnAwOkInv a := by
  constructor
  · exact mload64_awOk_of_ge3 (aw := a.aw) haw hawFit
  · have hloadMFit :
        MachineState.M a.aw.toNat (⟨64⟩ : UInt256).toNat 32 * 32 <
          UInt256.size := by
      exact machineState_M_mul32_lt_of_bounds
        (s := a.aw.toNat) (f := (⟨64⟩ : UInt256).toNat) (l := 32)
        hawFit (by
          change 64 + 32 + 31 < UInt256.size
          norm_num [UInt256.size])
    have hloadMSize :
        MachineState.M a.aw.toNat (⟨64⟩ : UInt256).toNat 32 < UInt256.size :=
      nat_lt_size_of_mul32_lt hloadMFit
    have hloadToNat :
        (collectReturnEncodeLoadAw a).toNat =
          MachineState.M a.aw.toNat (⟨64⟩ : UInt256).toNat 32 := by
      unfold collectReturnEncodeLoadAw
      exact UInt256.toNat_ofNat_of_lt hloadMSize
    have hloadFit : (collectReturnEncodeLoadAw a).toNat * 32 < UInt256.size := by
      rw [hloadToNat]
      exact hloadMFit
    have hloadGe : 3 ≤ (collectReturnEncodeLoadAw a).toNat := by
      rw [hloadToNat]
      exact le_trans haw machineState_M_ge_left
    have hoffFit :
        (a.freePtr + (⟨0⟩ : UInt256)).toNat + 32 + 31 < UInt256.size := by
      have hzero : a.freePtr + (⟨0⟩ : UInt256) = a.freePtr := by
        rw [u256_add_comm a.freePtr (⟨0⟩ : UInt256), u256_zero_add]
      rw [hzero]
      exact hfreePtrFit
    have hstoreMFit :
        MachineState.M (collectReturnEncodeLoadAw a).toNat
            (a.freePtr + (⟨0⟩ : UInt256)).toNat 32 * 32 <
          UInt256.size := by
      exact machineState_M_mul32_lt_of_bounds
        (s := (collectReturnEncodeLoadAw a).toNat)
        (f := (a.freePtr + (⟨0⟩ : UInt256)).toNat) (l := 32)
        hloadFit hoffFit
    have hstoreMSize :
        MachineState.M (collectReturnEncodeLoadAw a).toNat
            (a.freePtr + (⟨0⟩ : UInt256)).toNat 32 <
          UInt256.size :=
      nat_lt_size_of_mul32_lt hstoreMFit
    have hstoreToNat :
        (collectReturnStoreAw a).toNat =
          MachineState.M (collectReturnEncodeLoadAw a).toNat
            (a.freePtr + (⟨0⟩ : UInt256)).toNat 32 := by
      unfold collectReturnStoreAw
      exact UInt256.toNat_ofNat_of_lt hstoreMSize
    have hstoreFit : (collectReturnStoreAw a).toNat * 32 < UInt256.size := by
      rw [hstoreToNat]
      exact hstoreMFit
    have hstoreGe : 3 ≤ (collectReturnStoreAw a).toNat := by
      rw [hstoreToNat]
      exact le_trans hloadGe machineState_M_ge_left
    exact mload64_awOk_of_ge3
      (aw := collectReturnStoreAw a) hstoreGe hstoreFit

theorem collectSuccessNextCarry_return_memory_of_size_32 {a : CollectLoopCarry}
    {out : ByteArray} {ptr postAwRead : UInt256}
    {cA' : Batteries.RBSet AccountAddress compare} {σ' : AccountMap}
    {freePtr' inOffset copiedWord : UInt256}
    (hptr : ptr = collectPackedDataEnd a.freePtr)
    (hout : out.size = 32)
    (hfitFreePtr : a.freePtr.toNat + 128 < UInt256.size)
    (hptrGe : 96 ≤ (collectPackedDataEnd a.freePtr).toNat)
    (hcopyDest :
      (collectPackedDataEnd a.freePtr + ⟨32⟩).toNat ≤
        (collectReturndataLenMem
          (collectReturndataPtrMem
            (collectZeroOutCallMem
              (collectCopiedPackedCallMem a.mem a.freePtr a.idx freePtr' copiedWord)
              out inOffset)
            (collectPackedDataEnd a.freePtr) out)
          (collectPackedDataEnd a.freePtr) out).size) :
    collectReturnMemoryInv
      (collectSuccessNextCarry a out ptr postAwRead cA' σ'
        freePtr' inOffset copiedWord) := by
  subst ptr
  have hend :
      (collectPackedDataEnd a.freePtr).toNat = a.freePtr.toNat + 64 :=
    collectPackedDataEnd_toNat (by omega)
  have hptrAdd :
      (collectPackedDataEnd a.freePtr + (⟨32⟩ : UInt256)).toNat =
        (collectPackedDataEnd a.freePtr).toNat + 32 :=
    uadd_word_lit32_toNat (collectPackedDataEnd a.freePtr) (by
      rw [hend]
      omega)
  have hcover :
      (collectPackedDataEnd a.freePtr + ⟨32⟩).toNat + 32 ≤
        (collectReturndataMem
          (collectZeroOutCallMem
            (collectCopiedPackedCallMem a.mem a.freePtr a.idx freePtr' copiedWord)
            out inOffset)
          (collectPackedDataEnd a.freePtr) out).size := by
    unfold collectReturndataMem
    exact collectReturndataCopyMem_cover_of_size_32
      (mem :=
        collectReturndataLenMem
          (collectReturndataPtrMem
            (collectZeroOutCallMem
              (collectCopiedPackedCallMem a.mem a.freePtr a.idx freePtr' copiedWord)
              out inOffset)
            (collectPackedDataEnd a.freePtr) out)
          (collectPackedDataEnd a.freePtr) out)
      (out := out) (ptr := collectPackedDataEnd a.freePtr)
      hout hcopyDest
  have hnextFree :
      (collectSuccessNextCarry a out (collectPackedDataEnd a.freePtr) postAwRead cA' σ'
        freePtr' inOffset copiedWord).freePtr.toNat =
          a.freePtr.toNat + 128 :=
    collectSuccessNextCarry_freePtr_toNat_of_size_32
      (a := a) (out := out) (ptr := collectPackedDataEnd a.freePtr)
      (postAwRead := postAwRead) (cA' := cA') (σ' := σ')
      (freePtr' := freePtr') (inOffset := inOffset) (copiedWord := copiedWord)
      rfl hout hfitFreePtr
  unfold collectReturnMemoryInv
  constructor
  · change
      96 ≤
        (collectReturndataMem
          (collectZeroOutCallMem
            (collectCopiedPackedCallMem a.mem a.freePtr a.idx freePtr' copiedWord)
            out inOffset)
          (collectPackedDataEnd a.freePtr) out).size
    omega
  · rw [hnextFree]
    change
      a.freePtr.toNat + 128 -
          (collectReturndataMem
            (collectZeroOutCallMem
              (collectCopiedPackedCallMem a.mem a.freePtr a.idx freePtr' copiedWord)
              out inOffset)
            (collectPackedDataEnd a.freePtr) out).size <
        USize.size
    have hsize : a.freePtr.toNat + 128 ≤
        (collectReturndataMem
          (collectZeroOutCallMem
            (collectCopiedPackedCallMem a.mem a.freePtr a.idx freePtr' copiedWord)
            out inOffset)
          (collectPackedDataEnd a.freePtr) out).size := by
      rw [hptrAdd, hend] at hcover
      omega
    have hzero :
        a.freePtr.toNat + 128 -
            (collectReturndataMem
              (collectZeroOutCallMem
                (collectCopiedPackedCallMem a.mem a.freePtr a.idx freePtr' copiedWord)
                out inOffset)
              (collectPackedDataEnd a.freePtr) out).size = 0 := by
      omega
    rw [hzero]
    exact Nat.zero_lt_of_lt USize.size_pos

theorem collectFreePtr_fit160_of_stride_bound_le_max {a : CollectLoopCarry}
    (hstride : collectFreePtrStrideInv a)
    (hidxLe : a.idx.toNat ≤ a.bound.toNat)
    (hboundMax : a.bound.toNat ≤ solcMaxU64) :
    a.freePtr.toNat + 160 < UInt256.size := by
  unfold collectFreePtrStrideInv at hstride
  rw [hstride]
  have hidxMax : a.idx.toNat ≤ solcMaxU64 := by
    omega
  have hmax : 128 + 128 * solcMaxU64 + 160 < UInt256.size := by
    norm_num [ABI.solcMaxU64, UInt256.size]
  omega

