theorem collectRuntimeEquivalenceFor_sameMap_from_header
    {cA : Batteries.RBSet AccountAddress compare}
    {gh : BlockHeader} {bl : ProcessedBlocks} {σ σ₀ : AccountMap}
    {A : Substate} {I : ExecutionEnv} {g : Sat256}
    {v : ℕ} {a : CollectLoopCarry} {targets : List Value} {L : Store} {k C : ℕ}
    (hcode : I.code = retdataLoopBytecode)
    (hd : dispatchMsg contract I.calldata = some collectTransition)
    (hdec :
      decodeCalldataWithMode retdataLoopConfig.abiDecodeMode
        (collectTransition.params.map Param.name)
        (transitionSignature collectTransition).paramTypes I.calldata = some L)
    (hloop : CollectLoopRunFromHeader I g (initState cA gh bl σ σ₀ g A I))
    (hreturn : ∀ a L evm,
      collectCoreInv I (initState cA gh bl σ σ₀ g A I) 0 a L evm →
      CollectReturnEncodePackage a)
    (hvalue : I.weiValue = ⟨0⟩)
    (htargets : L.get? "targets" = some (.array targets))
    (hInv :
      collectCoreInv I (initState cA gh bl σ σ₀ g A I) v a
        (((L.insert "n" (.int (Int.ofNat targets.length))).insert "total" (.int 0)).insert
          "i" (.int 0))
        (initState cA gh bl σ σ₀ g A I))
    (rd :
      RD retdataLoopBytecode I g (initState cA gh bl σ σ₀ g A I) collectLoopHeaderPc
        (collectCarryStack a) a.mem a.aw (collectCarryRdata a) (collectCarryAcc a) k C) :
    runtimeEquivalenceFor retdataLoopConfig contract cA gh bl σ σ σ₀ g.toUInt256 A I := by
  have hvalue' :
      (initState cA gh bl σ σ₀ g A I).executionEnv.weiValue = ⟨0⟩ := by
    simpa [initState] using hvalue
  rcases collectBodyPrelude_from_header_to_return_or_revert
      (ee := I) (g := g) (s0 := initState cA gh bl σ σ₀ g A I)
      hloop hreturn (v := v) (a := a) (targets := targets) (L := L)
      (evm := initState cA gh bl σ σ₀ g A I) (k := k) (C := C)
      hvalue' htargets hInv rd with hOk | hRev
  · rcases hOk with ⟨a', L', evm', hbodyBlock, hInv', hrdret⟩
    have hbody :
        ExecTransitionBody retdataLoopConfig contract
          (initState cA gh bl σ σ₀ g A I) L collectTransition.body
          (.returned { contract := contract, locals := L' } evm'
            (some [.int (Int.ofNat a'.total.toNat)])) :=
      ExecFuncBody.execBlockRet hbodyBlock
    have hCreated : (collectCarryAcc a').1 = evm'.createdAccounts := by
      simpa [collectCarryAcc] using collectCoreInv_createdAccounts_eq
        (ee := I) (s0 := initState cA gh bl σ σ₀ g A I)
        (v := 0) (a := a') (L := L') (evm := evm') hInv'
    have hAccounts : accountMapEquiv (collectCarryAcc a').2 evm'.accountMap := by
      exact accountMapEquiv.of_eq (by
        simpa [collectCarryAcc] using collectCoreInv_accountMap_eq
          (ee := I) (s0 := initState cA gh bl σ σ₀ g A I)
          (v := 0) (a := a') (L := L') (evm := evm') hInv')
    have henc :
        returnEquiv (UInt256.toByteArray a'.total)
          (some [.int (Int.ofNat a'.total.toNat)]) collectTransition.returnType := by
      unfold collectTransition uint256 uint256Int
      exact returnEquiv_of_encode (uint256ReturnEncoding a'.total)
    exact hrdret.reEquivExecutionGenAccountMapEquiv hcode hd hdec hbody
      hCreated hAccounts henc
  · rcases hRev with ⟨hbodyBlock, hrdrev⟩
    have hbody :
        ExecTransitionBody retdataLoopConfig contract
          (initState cA gh bl σ σ₀ g A I) L collectTransition.body .reverted :=
      ExecFuncBody.execBlockRevert hbodyBlock
    exact hrdrev.reEquivExecutionRevert hcode hd hdec hbody

