theorem retdataLoopDispatch :
    SingleSelectorDispatch contract collectTransition ⟨#[0xa4, 0x52, 0x0a, 0xee]⟩ :=
  singleSelectorDispatch rfl rfl retdataLoopCollectSelectorBytes rfl

theorem retdataLoopDispatch_unique {cd : ByteArray} {t : TransitionDecl}
    (h : dispatchMsg contract cd = some t) : t = collectTransition :=
  dispatch_unique rfl rfl h

theorem retdataLoopDispatch_eq_some_of_match {cd : ByteArray}
    (hmatch : ((⟨#[0xa4, 0x52, 0x0a, 0xee]⟩ : ByteArray) == cd.extract 0 4) = true) :
    dispatchMsg contract cd = some collectTransition := by
  rw [retdataLoopDispatch.eq cd, if_pos hmatch]

theorem retdataLoopEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨2756840174⟩
        (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if ((⟨#[0xa4, 0x52, 0x0a, 0xee]⟩ : ByteArray) == cd.extract 0 4) then
          ⟨1⟩
        else
          ⟨0⟩ :=
  evmSelectorDecode hsz 0xa4 0x52 0x0a 0xee ⟨2756840174⟩ (by decide)

abbrev collectSelWord (I : ExecutionEnv) : UInt256 :=
  UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes 0 32)) ⟨224⟩

abbrev collectFirstArmPc : UInt256 := ⟨30⟩

theorem collectArmWellFormed : armWellFormed retdataLoopBytecode collectFirstArmPc :=
  ⟨by decide, by decide, by decide, by decide, by decide, by decide⟩

theorem collectArmSelNat :
    armSelNat retdataLoopBytecode collectFirstArmPc = ⟨2756840174⟩ := by
  decide

theorem collectMatch_eq (I : ExecutionEnv) (hsz : 4 ≤ I.calldata.size) :
    UInt256.eq (armSelNat retdataLoopBytecode collectFirstArmPc) (collectSelWord I)
      = if ((⟨#[0xa4, 0x52, 0x0a, 0xee]⟩ : ByteArray) == I.calldata.extract 0 4) then
          ⟨1⟩
        else
          ⟨0⟩ := by
  rw [collectArmSelNat]
  exact retdataLoopEvmSelector hsz

theorem collectReachDispatchBody {cA gh bl σ σ₀ A I} {g : Sat256}
    (hcode : I.code = retdataLoopBytecode)
    (hvalue : I.weiValue = ⟨0⟩)
    (hsize : I.calldata.size < UInt256.size)
    (hmatch : ((⟨#[0xa4, 0x52, 0x0a, 0xee]⟩ : ByteArray) == I.calldata.extract 0 4) = true) :
    ∃ k C,
      RD retdataLoopBytecode I g (initState cA gh bl σ σ₀ g A I) ⟨0x2d⟩
        [collectSelWord I] solcFreePtrMem (UInt256.ofNat 3) ByteArray.empty (cA, σ) k C := by
  have hsz : 4 ≤ I.calldata.size :=
    calldata_size_ge_of_selIs I (⟨#[0xa4, 0x52, 0x0a, 0xee]⟩ : ByteArray) (by decide) hmatch
  exact solcDispatchReachBody
    (firstArmPc := collectFirstArmPc) (bodyPC := ⟨0x2d⟩) (i := 0)
    hcode hvalue hsz hsize (by solc_dispatch_prefix) (by jump_dest)
    (fun j hj => by rw [Nat.le_zero.mp hj]; exact collectArmWellFormed)
    (fun j hj => absurd hj (by omega))
    (by
      show UInt256.eq (armSelNat retdataLoopBytecode collectFirstArmPc) (collectSelWord I) ≠ ⟨0⟩
      rw [collectMatch_eq I hsz, if_pos hmatch]
      decide)
    (by jump_dest) (by decide)

theorem collectDispatchBody_to_argsDecodeHelper {ee : ExecutionEnv} {g : Sat256}
    {s0 : State} {mem : ByteArray} {aw : UInt256} {rdata : ByteArray}
    {acc : Batteries.RBSet AccountAddress compare × AccountMap}
    {sel : UInt256} {rest : List UInt256} {k C : ℕ}
    (rd : RD retdataLoopBytecode ee g s0 ⟨0x2d⟩ (sel :: rest) mem aw rdata acc k C)
    (hsz : 4 ≤ ee.calldata.size)
    (hsize : ee.calldata.size < UInt256.size)
    (hov : rest.length + 8 ≤ 1024) :
    ∃ k' C',
      RD retdataLoopBytecode ee g s0 collectArgsDecodeHelperPc
        ((⟨4⟩ : UInt256) :: UInt256.ofNat ee.calldata.size ::
          collectAfterArgsDecodePc :: collectReturnEncodePc :: sel :: rest)
        mem aw rdata acc k' C' := by
  rw [show UInt256.ofNat ee.calldata.size =
        (⟨4⟩ : UInt256) + UInt256.sub (UInt256.ofNat ee.calldata.size) ⟨4⟩
      from (uadd_lit_usub_ofNat_lit hsz hsize).symm]
  have rdHelper := evm_run rd with [
    jumpdest, push2 ⟨0x47⟩, push1 ⟨4⟩, dup1, calldatasize, sub, dup2, add, swap1,
    push2 ⟨0x42⟩, swap2, swap1, push2 ⟨0x1d4⟩, jump (by jump_dest)]
  exact ⟨_, _, by
    simpa [collectArgsDecodeHelperPc, collectAfterArgsDecodePc, collectReturnEncodePc] using rdHelper⟩

theorem collectReachArgsDecodeHelper {cA gh bl σ σ₀ A I} {g : Sat256}
    (hcode : I.code = retdataLoopBytecode)
    (hvalue : I.weiValue = ⟨0⟩)
    (hsize : I.calldata.size < UInt256.size)
    (hmatch : ((⟨#[0xa4, 0x52, 0x0a, 0xee]⟩ : ByteArray) == I.calldata.extract 0 4) = true) :
    ∃ k C,
      RD retdataLoopBytecode I g (initState cA gh bl σ σ₀ g A I) collectArgsDecodeHelperPc
        ((⟨4⟩ : UInt256) :: UInt256.ofNat I.calldata.size ::
          collectAfterArgsDecodePc :: collectReturnEncodePc :: collectSelWord I :: [])
        solcFreePtrMem (UInt256.ofNat 3) ByteArray.empty (cA, σ) k C := by
  have hsz : 4 ≤ I.calldata.size :=
    calldata_size_ge_of_selIs I (⟨#[0xa4, 0x52, 0x0a, 0xee]⟩ : ByteArray) (by decide) hmatch
  obtain ⟨k, C, rdBody⟩ :=
    collectReachDispatchBody
      (cA := cA) (gh := gh) (bl := bl) (σ := σ) (σ₀ := σ₀) (A := A) (g := g)
      hcode hvalue hsize hmatch
  exact collectDispatchBody_to_argsDecodeHelper
    (ee := I) (g := g) (s0 := initState cA gh bl σ σ₀ g A I)
    (sel := collectSelWord I) (rest := []) rdBody hsz hsize (by simp)

theorem collectArrayDecodeHelper_success {g : Sat256} {s0 : State}
    {ee : ExecutionEnv} {k C : ℕ} {start ennd ret headOff len : UInt256}
    {R : List UInt256} {mem : ByteArray} {aw : UInt256} {rdata : ByteArray}
    {acc : Batteries.RBSet AccountAddress compare × AccountMap}
    (rd : RD retdataLoopBytecode ee g s0 collectArrayDecodeHelperPc
        (start :: ennd :: ret :: headOff :: R) mem aw rdata acc k C)
    (hstart : UInt256.slt (start + ⟨31⟩) ennd = ⟨1⟩)
    (hlen : uInt256OfByteArray (ee.calldata.readBytes start.toNat 32) = len)
    (hlenMax : UInt256.gt len ⟨18446744073709551615⟩ = ⟨0⟩)
    (hend : UInt256.gt ((start + ⟨32⟩) + UInt256.mul len (⟨32⟩ : UInt256)) ennd = ⟨0⟩)
    (hret : (D_J retdataLoopBytecode 0).contains ret = true)
    (hov : R.length + 12 ≤ 1024) :
    ∃ k' C', RD retdataLoopBytecode ee g s0 ret
      (len :: (start + ⟨32⟩) :: headOff :: R) mem aw rdata acc k' C' := by
  have rd194 := evm_run rd with [
    jumpdest, push0, push0, dup4, push1 ⟨31⟩, dup5, add, slt,
    push2 ⟨0x194⟩, jumpiT (by rw [hstart]; decide) (by jump_dest)]
  have rd199 := evm_run rd194 with [jumpdest, dup3, calldataload, swap1, pop]
  have rd1a2 := RD.pushConst rd199 ⟨18446744073709551615⟩ (width := 8) (op := .PUSH8)
    (by decide) (by native_decide) (by evm_ov)
  have rd1b1 := evm_run rd1a2 with [
    dup2, gt, iszero, push2 ⟨0x1b1⟩, jumpiT
      (by
        rw [hlen, hlenMax]
        decide)
      (by jump_dest)]
  obtain ⟨_, _, rd1b1z⟩ : ∃ k' C',
      RD retdataLoopBytecode ee g s0 ⟨0x1b1⟩
        (len :: ⟨0⟩ :: start :: ennd :: ret :: headOff :: R)
        mem aw rdata acc k' C' :=
    ⟨_, _, by simpa [hlen] using rd1b1⟩
  have rd1cd := evm_run rd1b1z with [
    jumpdest, push1 ⟨32⟩, dup4, add, swap2, pop, dup4, push1 ⟨32⟩,
    dup3, mul, dup4, add, gt, iszero, push2 ⟨0x1cd⟩,
    jumpiT
      (by
        rw [hend]
        decide)
      (by jump_dest)]
  exact ⟨_, _, evm_run rd1cd with [
    jumpdest, swap3, pop, swap3, swap1, pop, jump hret]⟩

theorem collectArgsDecodeHelper_to_arrayDecodeHelper {g : Sat256} {s0 : State}
    {ee : ExecutionEnv} {k C : ℕ} {start ennd ret off : UInt256}
    {R : List UInt256} {mem : ByteArray} {aw : UInt256} {rdata : ByteArray}
    {acc : Batteries.RBSet AccountAddress compare × AccountMap}
    (rd : RD retdataLoopBytecode ee g s0 collectArgsDecodeHelperPc
        (start :: ennd :: ret :: R) mem aw rdata acc k C)
    (hhead :
      UInt256.isZero (UInt256.slt (UInt256.sub ennd start) ⟨32⟩) ≠ ⟨0⟩)
    (hload : uInt256OfByteArray (ee.calldata.readBytes (start + (⟨0⟩ : UInt256)).toNat 32) = off)
    (hoffMax : UInt256.gt off ⟨18446744073709551615⟩ = ⟨0⟩)
    (hov : R.length + 12 ≤ 1024) :
    ∃ k' C',
      RD retdataLoopBytecode ee g s0 collectArrayDecodeHelperPc
        ((start + off) :: ennd :: (⟨0x213⟩ : UInt256) :: off ::
          (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) :: start :: ennd :: ret :: R)
        mem aw rdata acc k' C' := by
  have rd1ea := evm_run rd with [
    jumpdest, push0, push0, push1 ⟨32⟩, dup4, dup6, sub, slt, iszero,
    push2 ⟨0x1ea⟩, jumpiT hhead (by jump_dest)]
  have rd1fa := evm_run rd1ea with [jumpdest, push0, dup4, add, calldataload]
  have rd1fb := RD.pushConst rd1fa ⟨18446744073709551615⟩ (width := 8) (op := .PUSH8)
    (by decide) (by native_decide) (by evm_ov)
  have rd207 := evm_run rd1fb with [
    dup2, gt, iszero, push2 ⟨0x207⟩, jumpiT
      (by
        rw [hload, hoffMax]
        decide)
      (by jump_dest)]
  obtain ⟨_, _, rd207z⟩ : ∃ k' C',
      RD retdataLoopBytecode ee g s0 ⟨0x207⟩
        (off :: (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) :: start :: ennd :: ret :: R)
        mem aw rdata acc k' C' :=
    ⟨_, _, by simpa [hload] using rd207⟩
  have rd17f := evm_run rd207z with [
    jumpdest, push2 ⟨0x213⟩, dup6, dup3, dup7, add, push2 collectArrayDecodeHelperPc,
    jump (by jump_dest)]
  exact ⟨_, _, by
    simpa [collectArrayDecodeHelperPc] using rd17f⟩

theorem collectArgsDecodeHelper_success {g : Sat256} {s0 : State}
    {ee : ExecutionEnv} {k C : ℕ} {start ennd ret off len : UInt256}
    {R : List UInt256} {mem : ByteArray} {aw : UInt256} {rdata : ByteArray}
    {acc : Batteries.RBSet AccountAddress compare × AccountMap}
    (rd : RD retdataLoopBytecode ee g s0 collectArgsDecodeHelperPc
        (start :: ennd :: ret :: R) mem aw rdata acc k C)
    (hhead :
      UInt256.isZero (UInt256.slt (UInt256.sub ennd start) ⟨32⟩) ≠ ⟨0⟩)
    (hloadHead : uInt256OfByteArray
        (ee.calldata.readBytes (start + (⟨0⟩ : UInt256)).toNat 32) = off)
    (hoffMax : UInt256.gt off ⟨18446744073709551615⟩ = ⟨0⟩)
    (hstart : UInt256.slt ((start + off) + ⟨31⟩) ennd = ⟨1⟩)
    (hlen : uInt256OfByteArray (ee.calldata.readBytes (start + off).toNat 32) = len)
    (hlenMax : UInt256.gt len ⟨18446744073709551615⟩ = ⟨0⟩)
    (hend :
      UInt256.gt (((start + off) + ⟨32⟩) + UInt256.mul len (⟨32⟩ : UInt256)) ennd =
        ⟨0⟩)
    (hret : (D_J retdataLoopBytecode 0).contains ret = true)
    (hov : R.length + 18 ≤ 1024) :
    ∃ k' C',
      RD retdataLoopBytecode ee g s0 ret
        (len :: ((start + off) + ⟨32⟩) :: R) mem aw rdata acc k' C' := by
  obtain ⟨k1, C1, rdArray⟩ :=
    collectArgsDecodeHelper_to_arrayDecodeHelper
      (g := g) (s0 := s0) (ee := ee) (start := start) (ennd := ennd)
      (ret := ret) (off := off) (R := R) rd hhead hloadHead hoffMax
      (by omega)
  obtain ⟨k2, C2, rd213⟩ :=
    collectArrayDecodeHelper_success
      (g := g) (s0 := s0) (ee := ee) (start := start + off) (ennd := ennd)
      (ret := (⟨0x213⟩ : UInt256)) (headOff := off) (len := len)
      (R := (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) :: start :: ennd :: ret :: R)
      rdArray hstart hlen hlenMax hend (by jump_dest) (by simp only [List.length_cons]; omega)
  have rdRet := evm_run rd213 with [
    jumpdest, swap3, pop, swap3, pop, pop, swap3, pop, swap3, swap1, pop,
    jump hret]
  exact ⟨_, _, by simpa using rdRet⟩

theorem collectDecode_callargs_targets_shape {I : ExecutionEnv} {L : Store}
    (hdec :
      decodeCalldataWithMode retdataLoopConfig.abiDecodeMode
        (collectTransition.params.map Param.name)
        (transitionSignature collectTransition).paramTypes I.calldata = some L) :
    ∃ targets : List Value,
      L = (∅ : Store).insert "targets" (.array targets) := by
  change decodeCalldata ["targets"] [addrArrayTy] I.calldata = some L at hdec
  unfold decodeCalldata at hdec
  simp only [List.isEmpty_cons] at hdec
  split at hdec
  · contradiction
  next _ =>
    split at hdec
    · contradiction
    next _ =>
      simp [decodeCalldata.decodeArgs, decodeABIValues?, abiTupleHeadSize?, isDynamicABIType,
        Option.bind, bind, addrArrayTy, addr] at hdec
      cases h0 : readNat? (List.drop 4 I.calldata.toList) 0 with
      | none => simp [h0] at hdec
      | some off0 =>
          by_cases hmax0 : solcMaxU64 < off0
          · simp [h0, hmax0] at hdec
          · simp [h0, hmax0] at hdec
            cases hval0 : decodeABIValue? (.dynamicArray (.elem .address))
                  (List.drop 4 I.calldata.toList) off0 with
            | none => simp [hval0] at hdec
            | some p0 =>
                rcases p0 with ⟨v0, _⟩
                rcases decodeABIValue_dynamicArray_is_array hval0 with ⟨targets, rfl⟩
                simp [hval0, decodeCalldata.insertValues] at hdec
                by_cases hargsShort : I.calldata.toList.length - 4 < 32
                · simp [hargsShort] at hdec
                · simp [hargsShort] at hdec
                  rcases hdec with ⟨_, hstore⟩
                  exact ⟨targets, hstore.2.symm⟩

theorem collectDecode_calldata_size_lt_sign {I : ExecutionEnv} {L : Store}
    (hdec :
      decodeCalldataWithMode retdataLoopConfig.abiDecodeMode
        (collectTransition.params.map Param.name)
        (transitionSignature collectTransition).paramTypes I.calldata = some L) :
    I.calldata.size < 2 ^ 255 := by
  change decodeCalldata ["targets"] [addrArrayTy] I.calldata = some L at hdec
  unfold decodeCalldata at hdec
  split at hdec
  · contradiction
  next _ =>
    split at hdec
    · contradiction
    next hnotHuge =>
      have htlen : I.calldata.toList.length = I.calldata.size := by
        rw [byteArray_toList_eq, Array.length_toList]
        rfl
      by_contra hsmall
      apply hnotHuge
      constructor
      · decide
      · rw [htlen]
        exact Nat.le_of_not_gt hsmall

theorem collectDecode_targets_array_facts {I : ExecutionEnv} {L : Store}
    {targets : List Value}
    (hdec :
      decodeCalldataWithMode retdataLoopConfig.abiDecodeMode
        (collectTransition.params.map Param.name)
        (transitionSignature collectTransition).paramTypes I.calldata = some L)
    (htargets : L.get? "targets" = some (.array targets)) :
    ∃ off len : Nat,
      readNat? (List.drop 4 I.calldata.toList) 0 = some off ∧
      ¬ solcMaxU64 < off ∧
      readNat? (List.drop 4 I.calldata.toList) off = some len ∧
      ¬ solcMaxU64 < len ∧
      targets.length = len ∧
      4 + off + 32 + 32 * len ≤ I.calldata.size := by
  change decodeCalldata ["targets"] [addrArrayTy] I.calldata = some L at hdec
  unfold decodeCalldata at hdec
  simp only [List.isEmpty_cons] at hdec
  split at hdec
  · contradiction
  next _ =>
    split at hdec
    · contradiction
    next _ =>
      simp [decodeCalldata.decodeArgs, decodeABIValues?, abiTupleHeadSize?, isDynamicABIType,
        Option.bind, bind, addrArrayTy, addr] at hdec
      cases h0 : readNat? (List.drop 4 I.calldata.toList) 0 with
      | none => simp [h0] at hdec
      | some off0 =>
          by_cases hmax0 : solcMaxU64 < off0
          · simp [h0, hmax0] at hdec
          · simp [h0, hmax0] at hdec
            cases hval0 : decodeABIValue? (.dynamicArray (.elem .address))
                  (List.drop 4 I.calldata.toList) off0 with
            | none => simp [hval0] at hdec
            | some p0 =>
                rcases p0 with ⟨v0, end0⟩
                rcases decodeABIValue_dynamicArray_is_array hval0 with ⟨targets0, hv0⟩
                subst hv0
                simp [hval0, decodeCalldata.insertValues] at hdec
                by_cases hargsShort : I.calldata.toList.length - 4 < 32
                · simp [hargsShort] at hdec
                · simp [hargsShort] at hdec
                  rcases hdec with ⟨_, hstore⟩
                  have hL : L = (∅ : Store).insert "targets" (.array targets0) :=
                    hstore.2.symm
                  have htargets0 : targets0 = targets := by
                    rw [hL, Reasoning.Theory.store_get_self] at htargets
                    cases htargets
                    rfl
                  obtain ⟨len, hreadLen, hmaxLen, hend, hendLe, hvaluesLen⟩ :=
                    decodeABIValue_dynamicArray_elem32_facts
                      (elem := .address) (bytes := List.drop 4 I.calldata.toList)
                      (start := off0) (values := targets0) (endOffset := end0)
                      hval0
                  have htargetsLen : targets.length = len := by
                    rw [← htargets0, hvaluesLen]
                  have htlen : I.calldata.toList.length = I.calldata.size := by
                    rw [byteArray_toList_eq, Array.length_toList]
                    rfl
                  have hendSize : 4 + off0 + 32 + 32 * len ≤ I.calldata.size := by
                    rw [hend] at hendLe
                    rw [List.length_drop, htlen] at hendLe
                    omega
                  exact ⟨off0, len, rfl, hmax0, hreadLen, hmaxLen,
                    htargetsLen, hendSize⟩

theorem collectDecode_targets_lookup_shape {I : ExecutionEnv} {L : Store}
    {targets : List Value} {i : Nat}
    (hdec :
      decodeCalldataWithMode retdataLoopConfig.abiDecodeMode
        (collectTransition.params.map Param.name)
        (transitionSignature collectTransition).paramTypes I.calldata = some L)
    (htargets : L.get? "targets" = some (.array targets))
    (hbound : i < targets.length) :
    ∃ (off : Nat) (value : UInt256),
      readNat? (List.drop 4 I.calldata.toList) 0 = some off ∧
      lookupNth? targets i = some (.address (AccountAddress.ofNat value.toNat)) ∧
      readNat? (List.drop 4 I.calldata.toList) (off + 32 + 32 * i) =
        some value.toNat ∧
      value.toNat < EVM.addressModulus := by
  change decodeCalldata ["targets"] [addrArrayTy] I.calldata = some L at hdec
  unfold decodeCalldata at hdec
  simp only [List.isEmpty_cons] at hdec
  split at hdec
  · contradiction
  next _ =>
    split at hdec
    · contradiction
    next _ =>
      simp [decodeCalldata.decodeArgs, decodeABIValues?, abiTupleHeadSize?, isDynamicABIType,
        Option.bind, bind, addrArrayTy, addr] at hdec
      cases h0 : readNat? (List.drop 4 I.calldata.toList) 0 with
      | none => simp [h0] at hdec
      | some off0 =>
          by_cases hmax0 : solcMaxU64 < off0
          · simp [h0, hmax0] at hdec
          · simp [h0, hmax0] at hdec
            cases hval0 : decodeABIValue? (.dynamicArray (.elem .address))
                  (List.drop 4 I.calldata.toList) off0 with
            | none => simp [hval0] at hdec
            | some p0 =>
                rcases p0 with ⟨v0, end0⟩
                rcases decodeABIValue_dynamicArray_is_array hval0 with ⟨targets0, hv0⟩
                subst hv0
                simp [hval0, decodeCalldata.insertValues] at hdec
                by_cases hargsShort : I.calldata.toList.length - 4 < 32
                · simp [hargsShort] at hdec
                · simp [hargsShort] at hdec
                  rcases hdec with ⟨_, hstore⟩
                  have hL : L = (∅ : Store).insert "targets" (.array targets0) :=
                    hstore.2.symm
                  have htargets0 : targets0 = targets := by
                    rw [hL, Reasoning.Theory.store_get_self] at htargets
                    cases htargets
                    rfl
                  subst htargets0
                  obtain ⟨value, hlookup, hread, hcanon⟩ :=
                    decodeABIValue_dynamicArray_address_lookup_shape hval0 hbound
                  exact ⟨off0, value, rfl, hlookup, hread, hcanon⟩

theorem collectAfterArgsDecode_to_loopHeader {ee : ExecutionEnv} {g : Sat256}
    {s0 : State} {mem : ByteArray} {aw : UInt256} {rdata : ByteArray}
    {acc : Batteries.RBSet AccountAddress compare × AccountMap}
    {n targetBase ret sel : UInt256} {rest : List UInt256} {k C : ℕ}
    (rd : RD retdataLoopBytecode ee g s0 collectAfterArgsDecodePc
      (n :: targetBase :: ret :: sel :: rest) mem aw rdata acc k C)
    (hov : rest.length + 7 ≤ 1024) :
    ∃ k' C',
      RD retdataLoopBytecode ee g s0 collectLoopHeaderPc
        ((⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) :: n :: targetBase :: ret :: sel :: rest)
        mem aw rdata acc k' C' := by
  have rdHeader := evm_run rd with [
    jumpdest, push2 collectFunctionBodyPc, jump (by jump_dest),
    jumpdest, push0, push0, push0, swap1, pop]
  have hpc :
      collectFunctionBodyPc + ⟨1⟩ + ⟨1⟩ + ⟨1⟩ + ⟨1⟩ + ⟨1⟩ + ⟨1⟩ =
        collectLoopHeaderPc := by
    native_decide
  rw [hpc] at rdHeader
  exact ⟨_, _, by
    simpa [collectAfterArgsDecodePc, collectFunctionBodyPc, collectLoopHeaderPc]
      using rdHeader⟩

def collectPanicSelector : UInt256 :=
  UInt256.shiftLeft (⟨0x4e487b71⟩ : UInt256) ⟨224⟩

noncomputable def collectPanicMem0 (mem : ByteArray) : ByteArray :=
  (UInt256.toByteArray collectPanicSelector).write 0 mem 0 32

noncomputable def collectPanicMem (panicCode : UInt256) (mem : ByteArray) : ByteArray :=
  (UInt256.toByteArray panicCode).write 0 (collectPanicMem0 mem) 4 32

theorem collect_aw_mstore0_of_ge3 {aw : UInt256} (haw : 3 ≤ aw.toNat) :
    UInt256.ofNat (MachineState.M aw.toNat 0 32) = aw := by
  apply u256_inj
  simp [MachineState.M]
  rw [UInt256.toNat_ofNat_of_lt]
  · omega
  · exact lt_of_le_of_lt (by omega : max aw.toNat 1 ≤ aw.toNat) aw.val.isLt

theorem collect_aw_mstore4_of_ge3 {aw : UInt256} (haw : 3 ≤ aw.toNat) :
    UInt256.ofNat (MachineState.M aw.toNat 4 32) = aw := by
  apply u256_inj
  simp [MachineState.M]
  rw [UInt256.toNat_ofNat_of_lt]
  · omega
  · exact lt_of_le_of_lt (by omega : max aw.toNat 2 ≤ aw.toNat) aw.val.isLt

theorem collectPanic11Revert {ee : ExecutionEnv} {g : Sat256} {s0 : State}
    {mem : ByteArray} {aw : UInt256} {rdata : ByteArray}
    {acc : Batteries.RBSet AccountAddress compare × AccountMap}
    {R : List UInt256} {k C : ℕ}
    (rd : RD retdataLoopBytecode ee g s0 collectPanic11Pc R mem aw rdata acc k C)
    (haw : 3 ≤ aw.toNat)
    (hov : R.length + 2 ≤ 1024) :
    RDrev retdataLoopBytecode g s0 := by
  have hsel :
      UInt256.shiftLeft (⟨0x4e487b71⟩ : UInt256) ⟨224⟩ = collectPanicSelector := by
    rfl
  have rd0 := evm_run rd with [jumpdest]
  have rdSel0 := rd0.pushConst collectPanicSelector
    (width := 32) (op := .PUSH32) (by decide) (by decide) (by evm_ov)
  have rdSel := rdSel0
  rw [← hsel] at rdSel
  have rdMem0 := evm_run rdSel with [
    push0,
    raw mstore 0 (collectPanicMem0 mem) aw
      (by decide)
      (fun s haws hstk => by
        simp [memoryExpansionCost, memoryExpansionCost.μᵢ', haws, hstk]
        rw [collect_aw_mstore0_of_ge3 haw]
        simp)
      (by rfl) (collect_aw_mstore0_of_ge3 haw) (by evm_ov),
    push1 ⟨0x11⟩, push1 ⟨4⟩]
  have rdMem := evm_run rdMem0 with [
    raw mstore 0 (collectPanicMem ⟨0x11⟩ mem) aw
      (by decide)
      (fun s haws hstk => by
        simp [memoryExpansionCost, memoryExpansionCost.μᵢ', haws, hstk]
        rw [show (⟨4⟩ : UInt256).toNat = 4 by native_decide]
        rw [collect_aw_mstore4_of_ge3 haw]
        simp)
      (by rfl) (collect_aw_mstore4_of_ge3 haw) (by evm_ov),
    push1 ⟨0x24⟩, push0]
  exact rdMem.rev 0 (by decide)
    (fun s haws hstk => by
      simp [memoryExpansionCost, memoryExpansionCost.μᵢ', haws, hstk]
      rw [show (⟨36⟩ : UInt256).toNat = 36 by native_decide]
      have hM : MachineState.M aw.toNat 0 36 = aw.toNat := by
        simp [MachineState.M]
        omega
      rw [hM, u256_ofNat_toNat]
      omega)
    (by evm_ov)

def collectRoundedReturndataSize (out : ByteArray) : UInt256 :=
  UInt256.land (UInt256.ofNat out.size + ⟨63⟩) (UInt256.lnot ⟨31⟩)

def collectReturndataPtrMem (mem : ByteArray) (ptr : UInt256) (out : ByteArray) : ByteArray :=
  (UInt256.toByteArray (ptr + collectRoundedReturndataSize out)).write 0 mem
    (⟨64⟩ : UInt256).toNat 32

theorem collectRoundedReturndataSize_of_size_32 {out : ByteArray} (hout : out.size = 32) :
    collectRoundedReturndataSize out = ⟨64⟩ := by
