        ∧ out.size < UInt256.size
        ∧ RD retdataLoopBytecode ee g s0 collectPostCallPc
            ((if z then ⟨1⟩ else ⟨0⟩) :: (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
              a.idx :: a.total :: a.bound :: a.targetBase :: a.rest)
            (collectPostCallMemFrom a.mem a.freePtr a.idx freePtr' inOffset copiedWord out)
            (collectPostCallAwFrom awCallLoad freePtr' inOffset)
            out (cA', σ') kPost CPost
        ∧ (z = false →
            CollectCallFailurePostCallBranch ee g s0 v k C a L evm
              awCallLoad freePtr' inOffset copiedWord out)
        ∧ (z = true → out.size ≠ 32 →
            CollectBadLengthPostCallBranch ee g s0 v k C a L evm
              awCallLoad freePtr' inOffset copiedWord out)
        ∧ (z = true → out.size = 32 →
            CollectSuccessOrOverflowPostCallBranch ee g s0 v k C a L evm
              awCallLoad freePtr' inOffset copiedWord out))
    (onCallFailure : ∀ out,
      CollectCallFailurePostCallBranch ee g s0 v k C a L evm
        awCallLoad freePtr' inOffset copiedWord out →
      CollectLoopBodyOutcome ee g s0 v k C a L evm)
    (onBadLength : ∀ out,
      CollectBadLengthPostCallBranch ee g s0 v k C a L evm
        awCallLoad freePtr' inOffset copiedWord out →
      CollectLoopBodyOutcome ee g s0 v k C a L evm)
    (onSuccessOrOverflow : ∀ out,
      CollectSuccessOrOverflowPostCallBranch ee g s0 v k C a L evm
        awCallLoad freePtr' inOffset copiedWord out →
      CollectLoopBodyOutcome ee g s0 v k C a L evm) :
    CollectLoopBodyOutcome ee g s0 v k C a L evm := by
  rcases hbranches with
    ⟨_cA', _σ', z, out, _A', _evm', _kPost, _CPost,
      _hcall, _hevm', _houtLt, _rdPost, hfail, hbad, hsuccess⟩
  exact collectPostCall_bool_length_cases
    (P := CollectLoopBodyOutcome ee g s0 v k C a L evm)
    (z := z) (out := out)
    (fun hz => onCallFailure out (hfail hz))
    (fun hz houtNe => onBadLength out (hbad hz houtNe))
    (fun hz hout => onSuccessOrOverflow out (hsuccess hz hout))

