      (ptr + ⟨32⟩).toNat ≤
        (collectReturndataLenMem (collectReturndataPtrMem mem ptr out) ptr out).size) :
    (collectReturndataMem mem ptr out).readWithPadding 64 32 =
      UInt256.toByteArray (ptr + ⟨64⟩) := by
  unfold collectReturndataMem collectReturndataCopyMem
  rw [write_read_below_gen_extend out
    (collectReturndataLenMem (collectReturndataPtrMem mem ptr out) ptr out)
    (ptr + ⟨32⟩).toNat (UInt256.ofNat out.size).toNat 64]
  · unfold collectReturndataLenMem
    rw [toByteArray_write_read_below_of_gap (UInt256.ofNat out.size)
      (collectReturndataPtrMem mem ptr out) ptr.toNat 64]
    exact collectReturndataPtrMem_read64_of_size_32 hout hgapPtr
    · exact hptrMemSize
    · exact hptr
    · exact hgapLen
  · have hlt : out.size < UInt256.size := by
      rw [hout]
      native_decide
    have hlen : (UInt256.ofNat out.size).toNat = out.size :=
      UInt256.toNat_ofNat_of_lt hlt
    rw [hlen, hout]
    decide
  · have hlt : out.size < UInt256.size := by
      rw [hout]
      native_decide
    have hlen : (UInt256.ofNat out.size).toNat = out.size :=
      UInt256.toNat_ofNat_of_lt hlt
    rw [hlen]
  · exact hcopyDest
  · rw [uadd_word_lit32_toNat ptr hptrAdd]
    omega

