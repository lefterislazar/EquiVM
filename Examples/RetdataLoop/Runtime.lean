theorem collectPostCall_bool_length_cases {P : Prop} {z : Bool} {out : ByteArray}
    (hfail : z = false → P)
    (hbad : z = true → out.size ≠ 32 → P)
    (hsuccess : z = true → out.size = 32 → P) :
    P := by
  cases z
  · exact hfail rfl
  · by_cases hout : out.size = 32
    · exact hsuccess rfl hout
    · exact hbad rfl hout

theorem collectMloadCostSpec {aw off : UInt256} {stk : List UInt256} :
    ∀ st : State, st.machineState.activeWords = aw →
      st.machineState.stack = off :: stk →
      memoryExpansionCost st .MLOAD =
        Cₘ (UInt256.ofNat (MachineState.M aw.toNat off.toNat 32)) - Cₘ aw := by
  intro st haw hstk
  simp only [memoryExpansionCost, memoryExpansionCost.μᵢ', hstk, haw,
    List.getElem!_cons_zero]

theorem collectMstoreCostSpec {aw off val : UInt256} {stk : List UInt256} :
    ∀ st : State, st.machineState.activeWords = aw →
      st.machineState.stack = off :: val :: stk →
      memoryExpansionCost st .MSTORE =
        Cₘ (UInt256.ofNat (MachineState.M aw.toNat off.toNat 32)) - Cₘ aw := by
  intro st haw hstk
  simp only [memoryExpansionCost, memoryExpansionCost.μᵢ', hstk, haw,
    List.getElem!_cons_zero]

theorem collectReturndatacopyCostSpec {aw dst off len : UInt256} {stk : List UInt256} :
    ∀ st : State, st.machineState.activeWords = aw →
      st.machineState.stack = dst :: off :: len :: stk →
      memoryExpansionCost st .RETURNDATACOPY =
        Cₘ (UInt256.ofNat (MachineState.M aw.toNat dst.toNat len.toNat)) - Cₘ aw := by
  intro st haw hstk
  simp only [memoryExpansionCost, memoryExpansionCost.μᵢ', hstk, haw,
    List.getElem!_cons_zero, List.getElem!_cons_succ]

def CollectBodyPostCallResult (ee : ExecutionEnv) (g : Sat256) (s0 : State)
    (a : CollectLoopCarry) (evm : EVM.State)
    (awCallLoad freePtr' inOffset copiedWord : UInt256) : Prop :=
  ∃ (cA' : Batteries.RBSet AccountAddress compare) (σ' : AccountMap)
    (z : Bool) (out : ByteArray) (A' : Substate) (evm' : EVM.State)
    (kPost CPost : ℕ),
    callViaEVM evm
      (AccountAddress.ofUInt256 (collectMaskedTarget ee a.idx a.targetBase)) 0
      (collectCallInputData a.mem a.freePtr a.idx freePtr' inOffset copiedWord)
      (z, evm', out)
    ∧ evm' = { evm with accountMap := σ', substate := A', createdAccounts := cA' }
    ∧ out.size < UInt256.size
    ∧
    RD retdataLoopBytecode ee g s0 collectPostCallPc
      ((if z then ⟨1⟩ else ⟨0⟩) :: (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
        a.idx :: a.total :: a.bound :: a.targetBase :: a.rest)
      (collectPostCallMemFrom a.mem a.freePtr a.idx freePtr' inOffset copiedWord out)
      (collectPostCallAwFrom awCallLoad freePtr' inOffset)
      out (cA', σ') kPost CPost

theorem collectBodyEnterPostCallResult_to_postCallResult
    {ee : ExecutionEnv} {g : Sat256} {s0 : State}
    {v : ℕ} {a : CollectLoopCarry} {L : Store} {evm : EVM.State}
    {awCallLoad freePtr' inOffset copiedWord : UInt256}
    (hInv : collectCoreInv ee s0 (v + 1) a L evm)
    (hres :
      collectBodyEnterPostCallResult ee g s0 a.mem awCallLoad a.cA a.σ
        (collectMaskedTarget ee a.idx a.targetBase) (⟨0⟩ : UInt256) (⟨0⟩ : UInt256)
        a.idx a.total a.bound a.targetBase a.freePtr freePtr' inOffset copiedWord
        a.rest)
    (hperm : ee.perm = true)
    (hdepth : ee.depth.val < 1024) :
    CollectBodyPostCallResult ee g s0 a evm awCallLoad freePtr' inOffset copiedWord := by
  rcases hInv with
    ⟨_hi, _hn, _htotal, _hvar, _hle, hEnv, hCreated, hGenesis, hBlocks, hMap, hOrig⟩
  obtain ⟨cA', σ', z, out, A', evm', kPost, CPost,
      hcall, hevm', houtLt, rdPost⟩ :=
    collectBodyEnterPostCallResult_callViaEVM
      (evm := evm) hres hEnv hCreated hGenesis hBlocks hMap hOrig hperm hdepth
  exact ⟨cA', σ', z, out, A', evm', kPost, CPost,
    by simpa [collectCallInputData] using hcall,
    hevm',
    houtLt,
    by simpa [collectPostCallMemFrom, collectPostCallAwFrom] using rdPost⟩

def CollectCallFailurePostCallBranch (ee : ExecutionEnv) (g : Sat256) (s0 : State)
    (v k C : ℕ) (a : CollectLoopCarry) (L : Store) (evm : EVM.State)
    (awCallLoad freePtr' inOffset copiedWord : UInt256) (out : ByteArray) : Prop :=
  ∀ {awLoad awStorePtr awStoreLen awCopy ptr : UInt256}
    {mcLoad mcStorePtr mcStoreLen mcCopy : ℕ},
    (if (⟨64⟩ : UInt256).toNat ≥
          (collectPostCallMemFrom a.mem a.freePtr a.idx freePtr' inOffset copiedWord out).size ∨
        (⟨64⟩ : UInt256) ≥
          collectPostCallAwFrom awCallLoad freePtr' inOffset * ⟨32⟩ then ⟨0⟩
     else UInt256.ofNat
        (fromByteArrayBigEndian
          ((collectPostCallMemFrom a.mem a.freePtr a.idx freePtr' inOffset copiedWord out)
            |>.readWithPadding (⟨64⟩ : UInt256).toNat 32))) = ptr →
    (∀ s : State,
      s.machineState.activeWords = collectPostCallAwFrom awCallLoad freePtr' inOffset →
      s.machineState.stack =
        (⟨64⟩ : UInt256) :: UInt256.ofNat out.size :: UInt256.ofNat out.size ::
          (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
          a.idx :: a.total :: a.bound :: a.targetBase :: a.rest →
      memoryExpansionCost s .MLOAD = mcLoad) →
    UInt256.ofNat
      (MachineState.M (collectPostCallAwFrom awCallLoad freePtr' inOffset).toNat
        (⟨64⟩ : UInt256).toNat 32) = awLoad →
    (∀ s : State, s.machineState.activeWords = awLoad →
      s.machineState.stack =
        (⟨64⟩ : UInt256) :: (ptr + collectRoundedReturndataSize out) ::
          UInt256.ofNat out.size :: ptr :: (⟨0⟩ : UInt256) ::
          (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
          a.idx :: a.total :: a.bound :: a.targetBase :: a.rest →
      memoryExpansionCost s .MSTORE = mcStorePtr) →
    UInt256.ofNat (MachineState.M awLoad.toNat (⟨64⟩ : UInt256).toNat 32) =
      awStorePtr →
    (∀ s : State, s.machineState.activeWords = awStorePtr →
      s.machineState.stack =
        ptr :: UInt256.ofNat out.size :: UInt256.ofNat out.size :: ptr ::
          (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
          a.idx :: a.total :: a.bound :: a.targetBase :: a.rest →
      memoryExpansionCost s .MSTORE = mcStoreLen) →
    UInt256.ofNat (MachineState.M awStorePtr.toNat ptr.toNat 32) = awStoreLen →
    (∀ s : State, s.machineState.activeWords = awStoreLen →
      s.machineState.stack =
        (ptr + ⟨32⟩) :: (⟨0⟩ : UInt256) :: UInt256.ofNat out.size ::
          UInt256.ofNat out.size :: ptr :: (⟨0⟩ : UInt256) ::
          (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
          a.idx :: a.total :: a.bound :: a.targetBase :: a.rest →
      memoryExpansionCost s .RETURNDATACOPY = mcCopy) →
    UInt256.ofNat
      (MachineState.M awStoreLen.toNat (ptr + ⟨32⟩).toNat
        (UInt256.ofNat out.size).toNat) = awCopy →
    CollectLoopBodyOutcome ee g s0 v k C a L evm

def CollectCallFailurePostCallWitnesses (a : CollectLoopCarry)
    (awCallLoad freePtr' inOffset copiedWord : UInt256) (out : ByteArray) : Prop :=
  ∃ (awLoad awStorePtr awStoreLen awCopy ptr : UInt256)
    (mcLoad mcStorePtr mcStoreLen mcCopy : ℕ),
    (if (⟨64⟩ : UInt256).toNat ≥
          (collectPostCallMemFrom a.mem a.freePtr a.idx freePtr' inOffset copiedWord out).size ∨
        (⟨64⟩ : UInt256) ≥
          collectPostCallAwFrom awCallLoad freePtr' inOffset * ⟨32⟩ then ⟨0⟩
     else UInt256.ofNat
        (fromByteArrayBigEndian
          ((collectPostCallMemFrom a.mem a.freePtr a.idx freePtr' inOffset copiedWord out)
            |>.readWithPadding (⟨64⟩ : UInt256).toNat 32))) = ptr
    ∧ (∀ s : State,
      s.machineState.activeWords = collectPostCallAwFrom awCallLoad freePtr' inOffset →
      s.machineState.stack =
        (⟨64⟩ : UInt256) :: UInt256.ofNat out.size :: UInt256.ofNat out.size ::
          (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
          a.idx :: a.total :: a.bound :: a.targetBase :: a.rest →
      memoryExpansionCost s .MLOAD = mcLoad)
    ∧ UInt256.ofNat
      (MachineState.M (collectPostCallAwFrom awCallLoad freePtr' inOffset).toNat
        (⟨64⟩ : UInt256).toNat 32) = awLoad
    ∧ (∀ s : State, s.machineState.activeWords = awLoad →
      s.machineState.stack =
        (⟨64⟩ : UInt256) :: (ptr + collectRoundedReturndataSize out) ::
          UInt256.ofNat out.size :: ptr :: (⟨0⟩ : UInt256) ::
          (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
          a.idx :: a.total :: a.bound :: a.targetBase :: a.rest →
      memoryExpansionCost s .MSTORE = mcStorePtr)
    ∧ UInt256.ofNat (MachineState.M awLoad.toNat (⟨64⟩ : UInt256).toNat 32) =
      awStorePtr
    ∧ (∀ s : State, s.machineState.activeWords = awStorePtr →
      s.machineState.stack =
        ptr :: UInt256.ofNat out.size :: UInt256.ofNat out.size :: ptr ::
          (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
          a.idx :: a.total :: a.bound :: a.targetBase :: a.rest →
      memoryExpansionCost s .MSTORE = mcStoreLen)
    ∧ UInt256.ofNat (MachineState.M awStorePtr.toNat ptr.toNat 32) = awStoreLen
    ∧ (∀ s : State, s.machineState.activeWords = awStoreLen →
      s.machineState.stack =
        (ptr + ⟨32⟩) :: (⟨0⟩ : UInt256) :: UInt256.ofNat out.size ::
          UInt256.ofNat out.size :: ptr :: (⟨0⟩ : UInt256) ::
          (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
          a.idx :: a.total :: a.bound :: a.targetBase :: a.rest →
      memoryExpansionCost s .RETURNDATACOPY = mcCopy)
    ∧ UInt256.ofNat
      (MachineState.M awStoreLen.toNat (ptr + ⟨32⟩).toNat
        (UInt256.ofNat out.size).toNat) = awCopy

theorem collectCallFailurePostCallWitnesses_default
    (a : CollectLoopCarry) (awCallLoad freePtr' inOffset copiedWord : UInt256)
    (out : ByteArray) :
    CollectCallFailurePostCallWitnesses a awCallLoad freePtr' inOffset copiedWord out := by
  let mem := collectPostCallMemFrom a.mem a.freePtr a.idx freePtr' inOffset copiedWord out
  let aw := collectPostCallAwFrom awCallLoad freePtr' inOffset
  let ptr : UInt256 :=
    if (⟨64⟩ : UInt256).toNat ≥ mem.size ∨ (⟨64⟩ : UInt256) ≥ aw * ⟨32⟩ then ⟨0⟩
    else UInt256.ofNat (fromByteArrayBigEndian (mem.readWithPadding (⟨64⟩ : UInt256).toNat 32))
  let awLoad := UInt256.ofNat (MachineState.M aw.toNat (⟨64⟩ : UInt256).toNat 32)
  let awStorePtr := UInt256.ofNat (MachineState.M awLoad.toNat (⟨64⟩ : UInt256).toNat 32)
  let awStoreLen := UInt256.ofNat (MachineState.M awStorePtr.toNat ptr.toNat 32)
  let awCopy :=
    UInt256.ofNat
      (MachineState.M awStoreLen.toNat (ptr + ⟨32⟩).toNat
        (UInt256.ofNat out.size).toNat)
  let mcLoad := Cₘ awLoad - Cₘ aw
  let mcStorePtr := Cₘ awStorePtr - Cₘ awLoad
  let mcStoreLen := Cₘ awStoreLen - Cₘ awStorePtr
  let mcCopy := Cₘ awCopy - Cₘ awStoreLen
  refine ⟨awLoad, awStorePtr, awStoreLen, awCopy, ptr,
    mcLoad, mcStorePtr, mcStoreLen, mcCopy, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp [ptr, mem, aw]
  · intro st haw hstk
    simpa [aw, awLoad, mcLoad] using
      (collectMloadCostSpec
        (aw := aw) (off := (⟨64⟩ : UInt256))
        (stk :=
          UInt256.ofNat out.size :: UInt256.ofNat out.size ::
            (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
            a.idx :: a.total :: a.bound :: a.targetBase :: a.rest)
        st haw hstk)
  · simp [aw, awLoad]
  · intro st haw hstk
    simpa [awStorePtr, mcStorePtr] using
      (collectMstoreCostSpec
        (aw := awLoad) (off := (⟨64⟩ : UInt256))
        (val := ptr + collectRoundedReturndataSize out)
        (stk :=
          UInt256.ofNat out.size :: ptr :: (⟨0⟩ : UInt256) ::
            (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
            a.idx :: a.total :: a.bound :: a.targetBase :: a.rest)
        st haw hstk)
  · simp [awStorePtr]
  · intro st haw hstk
    simpa [awStoreLen, mcStoreLen] using
      (collectMstoreCostSpec
        (aw := awStorePtr) (off := ptr) (val := UInt256.ofNat out.size)
        (stk :=
          UInt256.ofNat out.size :: ptr :: (⟨0⟩ : UInt256) ::
            (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
            a.idx :: a.total :: a.bound :: a.targetBase :: a.rest)
        st haw hstk)
  · simp [awStoreLen]
  · intro st haw hstk
    simpa [awCopy, mcCopy] using
      (collectReturndatacopyCostSpec
        (aw := awStoreLen) (dst := ptr + ⟨32⟩) (off := (⟨0⟩ : UInt256))
        (len := UInt256.ofNat out.size)
        (stk :=
          UInt256.ofNat out.size :: ptr :: (⟨0⟩ : UInt256) ::
            (⟨0⟩ : UInt256) :: (⟨0⟩ : UInt256) ::
            a.idx :: a.total :: a.bound :: a.targetBase :: a.rest)
        st haw hstk)
  · simp [awCopy]

theorem collectCallFailurePostCallBranch_of_witnesses
    {ee : ExecutionEnv} {g : Sat256} {s0 : State}
    {v k C : ℕ} {a : CollectLoopCarry} {L : Store} {evm : EVM.State}
    {awCallLoad freePtr' inOffset copiedWord : UInt256} {out : ByteArray}
    (hbranch :
      CollectCallFailurePostCallBranch ee g s0 v k C a L evm
        awCallLoad freePtr' inOffset copiedWord out)
