theorem collectRuntimeLoop_core_from_body_or_revert_carryRdata
    {ee : ExecutionEnv} {g : Sat256} {s0 : State}
    (hov : ∀ a : CollectLoopCarry, a.rest.length + 6 ≤ 1024)
