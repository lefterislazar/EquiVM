  rcases hwit with
    ⟨awLoad, awStorePtr, awStoreLen, awCopy, ptr,
      mcLoad, mcStorePtr, mcStoreLen, mcCopy,
      hfp, hmcLoad, hawLoad, hmcStorePtr, hawStorePtr, hmcStoreLen,
      hawStoreLen, hmcCopy, hawCopy⟩
  exact hbranch hfp hmcLoad hawLoad hmcStorePtr hawStorePtr hmcStoreLen
    hawStoreLen hmcCopy hawCopy

