structure CollectLoopCarry where
  idx : UInt256
  total : UInt256
  bound : UInt256
  targetBase : UInt256
  freePtr : UInt256
  rest : List UInt256
  mem : ByteArray
  aw : UInt256
  rdata : ByteArray
  cA : Batteries.RBSet AccountAddress compare
  σ : AccountMap

def collectCarryStack (a : CollectLoopCarry) : List UInt256 :=
  collectLoopStack a.idx a.total a.bound a.targetBase a.rest

def collectCarryAcc (a : CollectLoopCarry) :
    Batteries.RBSet AccountAddress compare × AccountMap :=
  (a.cA, a.σ)

def collectCarryRdata (a : CollectLoopCarry) : ByteArray :=
  a.rdata

def collectFreePtrStrideInv (a : CollectLoopCarry) : Prop :=
  a.freePtr.toNat = 128 + 128 * a.idx.toNat

def collectFreePtrMemInv (a : CollectLoopCarry) : Prop :=
  a.mem.readWithPadding 64 32 = UInt256.toByteArray a.freePtr

def collectFreePtrAllocatorInv (a : CollectLoopCarry) : Prop :=
  collectFreePtrStrideInv a ∧ collectFreePtrMemInv a

def collectAwFitInv (a : CollectLoopCarry) : Prop :=
  a.aw.toNat * 32 < UInt256.size

def collectReturnEncodeLoadAw (a : CollectLoopCarry) : UInt256 :=
  UInt256.ofNat (MachineState.M a.aw.toNat (⟨64⟩ : UInt256).toNat 32)

def collectReturnStoreAw (a : CollectLoopCarry) : UInt256 :=
  UInt256.ofNat
    (MachineState.M (collectReturnEncodeLoadAw a).toNat
      (a.freePtr + (⟨0⟩ : UInt256)).toNat 32)

def collectReturnLoadAw (a : CollectLoopCarry) : UInt256 :=
  UInt256.ofNat
    (MachineState.M (collectReturnStoreAw a).toNat (⟨64⟩ : UInt256).toNat 32)

def collectReturnMemoryInv (a : CollectLoopCarry) : Prop :=
  96 ≤ a.mem.size ∧ a.freePtr.toNat - a.mem.size < USize.size

def collectReturnAwOkInv (a : CollectLoopCarry) : Prop :=
  ¬ (⟨64⟩ : UInt256) ≥ a.aw * ⟨32⟩ ∧
  ¬ (⟨64⟩ : UInt256) ≥ collectReturnStoreAw a * ⟨32⟩

def collectReturnFitInv (a : CollectLoopCarry) : Prop :=
  a.freePtr.toNat + 32 < UInt256.size

def collectReturnReadyInv (a : CollectLoopCarry) : Prop :=
  collectFreePtrAllocatorInv a ∧
  collectReturnMemoryInv a ∧
  collectReturnAwOkInv a ∧
  collectReturnFitInv a

def collectInitialCarry (bound targetBase sel : UInt256)
    (cA : Batteries.RBSet AccountAddress compare) (σ : AccountMap) : CollectLoopCarry :=
  { idx := ⟨0⟩
    total := ⟨0⟩
    bound := bound
    targetBase := targetBase
    freePtr := ⟨128⟩
    rest := [collectReturnEncodePc, sel]
    mem := solcFreePtrMem
    aw := UInt256.ofNat 3
    rdata := ByteArray.empty
    cA := cA
    σ := σ }

def collectCoreInv (ee : ExecutionEnv) (s0 : State)
    (v : ℕ) (a : CollectLoopCarry) (L : Store) (evm : EVM.State) : Prop :=
  L.get? "i" = some (.int (Int.ofNat a.idx.toNat)) ∧
  L.get? "n" = some (.int (Int.ofNat a.bound.toNat)) ∧
  L.get? "total" = some (.int (Int.ofNat a.total.toNat)) ∧
  a.idx.toNat + v = a.bound.toNat ∧
  a.idx.toNat ≤ a.bound.toNat ∧
  evm.executionEnv = ee ∧
  evm.createdAccounts = a.cA ∧
  evm.genesisBlockHeader = s0.genesisBlockHeader ∧
  evm.blocks = s0.blocks ∧
  evm.accountMap = a.σ ∧
  evm.σ₀ = s0.σ₀

theorem collectCoreInv_shape {ee : ExecutionEnv} {s0 : State} :
    ∀ v a L evm, collectCoreInv ee s0 v a L evm →
      L.get? "i" = some (.int (Int.ofNat a.idx.toNat)) ∧
      L.get? "n" = some (.int (Int.ofNat a.bound.toNat)) ∧
      a.idx.toNat + v = a.bound.toNat ∧
      a.idx.toNat ≤ a.bound.toNat := by
  intro v a L evm hInv
  exact ⟨hInv.1, hInv.2.1, hInv.2.2.2.1, hInv.2.2.2.2.1⟩

theorem collectDecode_body_target_facts_of_slot {I : ExecutionEnv} {s0 : State}
    {v : ℕ} {a : CollectLoopCarry} {L : Store} {evm : EVM.State}
    {targets : List Value}
    (hdec :
      decodeCalldataWithMode retdataLoopConfig.abiDecodeMode
        (collectTransition.params.map Param.name)
        (transitionSignature collectTransition).paramTypes I.calldata = some L)
    (htargets : L.get? "targets" = some (.array targets))
    (hInv : collectCoreInv I s0 (v + 1) a L evm)
    (hboundCarry : a.bound.toNat = targets.length)
    (hslot : ∀ off : Nat,
      readNat? (List.drop 4 I.calldata.toList) 0 = some off →
      (collectTargetSlot a.idx a.targetBase + ⟨0⟩).toNat =
        4 + (off + 32 + 32 * a.idx.toNat)) :
    (collectTargetWord I a.idx a.targetBase).toNat < EVM.addressModulus ∧
      UInt256.land solcAddrMask (collectTargetWord I a.idx a.targetBase) =
        collectTargetWord I a.idx a.targetBase ∧
      evalExpr? retdataLoopConfig { contract := contract, locals := L } evm
        (arrGet "targets" (.var "i")) =
          .ok (.address (AccountAddress.ofUInt256
            (collectMaskedTarget I a.idx a.targetBase))) := by
  rcases collectCoreInv_shape (v + 1) a L evm hInv with ⟨hi, _hn, hsum, _hle⟩
  have hidx : a.idx.toNat < targets.length := by
    rw [← hboundCarry]
    omega
  obtain ⟨off, value, hread0, hlookup, hread, hcanonValue⟩ :=
    collectDecode_targets_lookup_shape
      (I := I) (L := L) (targets := targets) (i := a.idx.toNat)
      hdec htargets hidx
  have htargetWord : collectTargetWord I a.idx a.targetBase = value :=
    collectTargetWord_eq_of_readNat
      (I := I) (idx := a.idx) (targetBase := a.targetBase)
      (headOff := off + 32 + 32 * a.idx.toNat) (value := value)
      (hslot off hread0) hread
  have hcanonTarget : (collectTargetWord I a.idx a.targetBase).toNat < EVM.addressModulus := by
    rw [htargetWord]
    exact hcanonValue
  have hclean :
      UInt256.land solcAddrMask (collectTargetWord I a.idx a.targetBase) =
        collectTargetWord I a.idx a.targetBase := by
    rw [u256_land_comm solcAddrMask (collectTargetWord I a.idx a.targetBase),
      htargetWord]
    exact solcAddrMask_clean hcanonValue
  have haddr :
      AccountAddress.ofNat value.toNat =
        AccountAddress.ofUInt256 (collectMaskedTarget I a.idx a.targetBase) := by
    rw [collectMaskedTarget, hclean, htargetWord,
      accountAddress_ofUInt256_eq_ofNat_toNat]
  have hreceiver :=
    evalTargetsIndex_of_get (locals := L) (evm := evm)
      targets a.idx (.address (AccountAddress.ofNat value.toNat))
      (.address (AccountAddress.ofUInt256 (collectMaskedTarget I a.idx a.targetBase)))
      htargets hi hidx hlookup
      (by simp [normalizeRawBoolWord?, haddr])
  exact ⟨hcanonTarget, hclean, hreceiver⟩

theorem collectDecode_body_target_facts_of_base {I : ExecutionEnv} {s0 : State}
    {v : ℕ} {a : CollectLoopCarry} {L : Store} {evm : EVM.State}
    {targets : List Value}
    (hdec :
      decodeCalldataWithMode retdataLoopConfig.abiDecodeMode
        (collectTransition.params.map Param.name)
        (transitionSignature collectTransition).paramTypes I.calldata = some L)
    (htargets : L.get? "targets" = some (.array targets))
    (hInv : collectCoreInv I s0 (v + 1) a L evm)
    (hboundCarry : a.bound.toNat = targets.length)
    (hbase : ∀ off : Nat,
      readNat? (List.drop 4 I.calldata.toList) 0 = some off →
      a.targetBase.toNat = 4 + off + 32)
    (hmulfit : 32 * a.idx.toNat < UInt256.size)
    (hfit : ∀ off : Nat,
      readNat? (List.drop 4 I.calldata.toList) 0 = some off →
      32 * a.idx.toNat + (4 + off + 32) < UInt256.size) :
    (collectTargetWord I a.idx a.targetBase).toNat < EVM.addressModulus ∧
      UInt256.land solcAddrMask (collectTargetWord I a.idx a.targetBase) =
        collectTargetWord I a.idx a.targetBase ∧
      evalExpr? retdataLoopConfig { contract := contract, locals := L } evm
        (arrGet "targets" (.var "i")) =
          .ok (.address (AccountAddress.ofUInt256
            (collectMaskedTarget I a.idx a.targetBase))) := by
  refine collectDecode_body_target_facts_of_slot
    (I := I) (s0 := s0) (v := v) (a := a) (L := L) (evm := evm)
    (targets := targets) hdec htargets hInv hboundCarry ?_
  intro off hread0
  exact collectTargetSlot_add_zero_toNat_of_base
    (idx := a.idx) (targetBase := a.targetBase) (off := off) (i := a.idx.toNat)
    rfl (hbase off hread0) hmulfit (hfit off hread0)

theorem collectCoreInv_createdAccounts_eq {ee : ExecutionEnv} {s0 : State}
    {v : ℕ} {a : CollectLoopCarry} {L : Store} {evm : EVM.State}
    (hInv : collectCoreInv ee s0 v a L evm) :
    a.cA = evm.createdAccounts := by
  rcases hInv with
    ⟨_hi, _hn, _htotal, _hvar, _hle, _hEnv, hCreated, _hGenesis, _hBlocks, _hMap, _hOrig⟩
  exact hCreated.symm

theorem collectCoreInv_accountMap_eq {ee : ExecutionEnv} {s0 : State}
    {v : ℕ} {a : CollectLoopCarry} {L : Store} {evm : EVM.State}
    (hInv : collectCoreInv ee s0 v a L evm) :
    a.σ = evm.accountMap := by
  rcases hInv with
    ⟨_hi, _hn, _htotal, _hvar, _hle, _hEnv, _hCreated, _hGenesis, _hBlocks, hMap, _hOrig⟩
  exact hMap.symm

theorem collectInitialCarry_coreInv_init
    {cA : Batteries.RBSet AccountAddress compare}
    {gh : BlockHeader} {bl : ProcessedBlocks} {σ σ₀ : AccountMap}
    {A : Substate} {I : ExecutionEnv} {g : Sat256}
    {L : Store} {targets : List Value} {bound targetBase sel : UInt256}
    (hbound : bound.toNat = targets.length) :
    collectCoreInv I (initState cA gh bl σ σ₀ g A I) targets.length
      (collectInitialCarry bound targetBase sel cA σ)
      (((L.insert "n" (.int (Int.ofNat targets.length))).insert "total" (.int 0)).insert
        "i" (.int 0))
      (initState cA gh bl σ σ₀ g A I) := by
  unfold collectCoreInv collectInitialCarry
  constructor
  · rw [Reasoning.Theory.store_get_self]
    rfl
  constructor
  · rw [Reasoning.Theory.store_get_ne, Reasoning.Theory.store_get_ne,
      Reasoning.Theory.store_get_self]
    · rw [hbound]
    · decide
    · decide
  constructor
  · rw [Reasoning.Theory.store_get_ne, Reasoning.Theory.store_get_self]
    · rfl
    · decide
  constructor
  · simp [hbound]
  constructor
  · simp
  · simp [initState]

theorem collectAfterArgsDecode_to_initialCarryHeader {ee : ExecutionEnv} {g : Sat256}
    {s0 : State}
    {cA : Batteries.RBSet AccountAddress compare} {σ : AccountMap}
    {bound targetBase sel : UInt256} {k C : ℕ}
    (rd : RD retdataLoopBytecode ee g s0 collectAfterArgsDecodePc
      (bound :: targetBase :: collectReturnEncodePc :: sel :: [])
      solcFreePtrMem (UInt256.ofNat 3) ByteArray.empty (cA, σ) k C) :
    ∃ k' C',
      RD retdataLoopBytecode ee g s0 collectLoopHeaderPc
        (collectCarryStack (collectInitialCarry bound targetBase sel cA σ))
        solcFreePtrMem (UInt256.ofNat 3) ByteArray.empty (cA, σ) k' C' := by
  obtain ⟨k', C', rdHeader⟩ :=
    collectAfterArgsDecode_to_loopHeader
      (ee := ee) (g := g) (s0 := s0) (mem := solcFreePtrMem)
      (aw := UInt256.ofNat 3) (rdata := ByteArray.empty) (acc := (cA, σ))
      (n := bound) (targetBase := targetBase) (ret := collectReturnEncodePc)
      (sel := sel) (rest := []) rd (by simp)
  exact ⟨k', C', by
    simpa [collectInitialCarry, collectCarryStack, collectLoopStack] using rdHeader⟩

def collectSuccessNextCarry (a : CollectLoopCarry) (out : ByteArray)
    (ptr postAwRead : UInt256)
    (cA' : Batteries.RBSet AccountAddress compare) (σ' : AccountMap)
    (freePtr' inOffset copiedWord : UInt256) : CollectLoopCarry :=
  { idx := a.idx + ⟨1⟩
    total := a.total + collectSourceDecodedValue out
    bound := a.bound
    targetBase := a.targetBase
    freePtr := ptr + collectRoundedReturndataSize out
    rest := a.rest
    mem :=
      collectReturndataMem
        (collectZeroOutCallMem
          (collectCopiedPackedCallMem a.mem a.freePtr a.idx freePtr' copiedWord)
          out inOffset)
        ptr out
    aw := postAwRead
    rdata := out
    cA := cA'
    σ := σ' }

