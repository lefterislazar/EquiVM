theorem collectSuccessNextCarry_return_fit_of_size_32 {a : CollectLoopCarry}
    {out : ByteArray} {ptr postAwRead : UInt256}
    {cA' : Batteries.RBSet AccountAddress compare} {σ' : AccountMap}
    {freePtr' inOffset copiedWord : UInt256}
    (hptr : ptr = collectPackedDataEnd a.freePtr)
    (hout : out.size = 32)
    (hfitFreePtr : a.freePtr.toNat + 128 < UInt256.size)
    (hfitNextReturn : a.freePtr.toNat + 160 < UInt256.size) :
    collectReturnFitInv
      (collectSuccessNextCarry a out ptr postAwRead cA' σ'
        freePtr' inOffset copiedWord) := by
  unfold collectReturnFitInv
  rw [collectSuccessNextCarry_freePtr_toNat_of_size_32
    (a := a) (out := out) (ptr := ptr) (postAwRead := postAwRead)
    (cA' := cA') (σ' := σ') (freePtr' := freePtr') (inOffset := inOffset)
    (copiedWord := copiedWord) hptr hout hfitFreePtr]
  omega

theorem collectSuccessNextCarry_return_aw_ok_of_size_32 {a : CollectLoopCarry}
    {out : ByteArray} {ptr postAwRead : UInt256}
    {cA' : Batteries.RBSet AccountAddress compare} {σ' : AccountMap}
    {freePtr' inOffset copiedWord : UInt256}
    (hptr : ptr = collectPackedDataEnd a.freePtr)
    (hout : out.size = 32)
    (hfitFreePtr : a.freePtr.toNat + 128 < UInt256.size)
    (hfitNextAw : a.freePtr.toNat + 192 < UInt256.size)
    (hawPost : 3 ≤ postAwRead.toNat)
    (hawPostFit : postAwRead.toNat * 32 < UInt256.size) :
    collectReturnAwOkInv
      (collectSuccessNextCarry a out ptr postAwRead cA' σ'
        freePtr' inOffset copiedWord) := by
  let a' := collectSuccessNextCarry a out ptr postAwRead cA' σ'
    freePtr' inOffset copiedWord
  have hnextFree :
      a'.freePtr.toNat = a.freePtr.toNat + 128 :=
    collectSuccessNextCarry_freePtr_toNat_of_size_32
      (a := a) (out := out) (ptr := ptr) (postAwRead := postAwRead)
      (cA' := cA') (σ' := σ') (freePtr' := freePtr') (inOffset := inOffset)
      (copiedWord := copiedWord) hptr hout hfitFreePtr
  have hnextFit : a'.freePtr.toNat + 63 < UInt256.size := by
    rw [hnextFree]
