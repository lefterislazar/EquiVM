    exact congrArg Fin.val (by simpa [hEnv] using hdepthEq)

def collectSourceDecodedValue (out : ByteArray) : UInt256 :=
  UInt256.ofNat (fromByteArrayBigEndian (out.extract 0 32))

def collectRuntimeBodyLocals (locals : Store) (out : ByteArray) (total : UInt256) : Store :=
  let value : UInt256 := collectSourceDecodedValue out
  (collectValueLocals locals out value).insert "total"
    (.int (Int.ofNat (UInt256.ofNat (total.toNat + value.toNat)).toNat))

def collectRuntimePostLocals
    (locals : Store) (out : ByteArray) (idx total : UInt256) : Store :=
  (collectRuntimeBodyLocals locals out total).insert "i"
    (.int (Int.ofNat idx.toNat + 1))

theorem collectRuntimePostLocals_get_i {locals : Store} {out : ByteArray}
    {idx total : UInt256} :
    (collectRuntimePostLocals locals out idx total).get? "i" =
      some (.int (Int.ofNat idx.toNat + 1)) := by
  unfold collectRuntimePostLocals
  exact Reasoning.Theory.store_get_self
    (collectRuntimeBodyLocals locals out total) "i"
    (.int (Int.ofNat idx.toNat + 1))

theorem collectRuntimePostLocals_get_total {locals : Store} {out : ByteArray}
    {idx total : UInt256} :
    (collectRuntimePostLocals locals out idx total).get? "total" =
      some
        (.int
          (Int.ofNat
            (UInt256.ofNat
              (total.toNat + (collectSourceDecodedValue out).toNat)).toNat)) := by
  unfold collectRuntimePostLocals collectRuntimeBodyLocals
  rw [Reasoning.Theory.store_get_ne]
  · exact Reasoning.Theory.store_get_self
      (collectValueLocals locals out (collectSourceDecodedValue out)) "total"
      (.int
        (Int.ofNat
          (UInt256.ofNat
            (total.toNat + (collectSourceDecodedValue out).toNat)).toNat))
  · decide

theorem collectRuntimePostLocals_get_n {locals : Store} {out : ByteArray}
    {idx total n : UInt256}
    (hn : locals.get? "n" = some (.int (Int.ofNat n.toNat))) :
    (collectRuntimePostLocals locals out idx total).get? "n" =
      some (.int (Int.ofNat n.toNat)) := by
  unfold collectRuntimePostLocals collectRuntimeBodyLocals collectValueLocals collectCallLocals
  rw [Reasoning.Theory.store_get_ne, Reasoning.Theory.store_get_ne,
    Reasoning.Theory.store_get_ne, Reasoning.Theory.store_get_ne,
    Reasoning.Theory.store_get_ne, hn]
  · decide
  · decide
  · decide
  · decide
  · decide

theorem uadd_toNat_of_lt {a b : UInt256} (hfit : a.toNat + b.toNat < UInt256.size) :
    (a + b).toNat = a.toNat + b.toNat := by
  rw [uadd_toNat, Nat.mod_eq_of_lt hfit]

theorem uadd_one_toNat_of_lt {idx : UInt256} (hfit : idx.toNat + 1 < UInt256.size) :
    (idx + (⟨1⟩ : UInt256)).toNat = idx.toNat + 1 := by
  rw [uadd_toNat, show (⟨1⟩ : UInt256).toNat = 1 from by decide,
    Nat.mod_eq_of_lt hfit]

theorem int_ofNat_uadd_one_toNat {idx : UInt256}
    (hfit : idx.toNat + 1 < UInt256.size) :
    Int.ofNat (idx + (⟨1⟩ : UInt256)).toNat = Int.ofNat idx.toNat + 1 := by
  rw [uadd_one_toNat_of_lt hfit]
  simp [Nat.cast_add]

theorem accountAddress_ofUInt256_eq_evm_address (w : UInt256) :
    AccountAddress.ofUInt256 w = EVM.address (AccountAddress.ofUInt256 w).val := by
  apply Fin.ext
  simp [EVM.address, EVM.uintN]
  exact (Nat.mod_eq_of_lt (by
    simp [AccountAddress.size, EVM.twoPow])).symm

