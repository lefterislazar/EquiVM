    (hfitTotal : a.total.toNat + (collectSourceDecodedValue out).toNat < UInt256.size) :
    ∃ a' L1' evm1 L2' evm2 k'' C'',
      (ExecBlock retdataLoopConfig { contract := contract, locals := L } evm
          collectLoopBody
          (.ok { contract := contract, locals := L1' } evm1) ∨
        ExecBlock retdataLoopConfig { contract := contract, locals := L } evm
          collectLoopBody
          (.continue { contract := contract, locals := L1' } evm1)) ∧
      ExecBlock retdataLoopConfig { contract := contract, locals := L1' } evm1
        collectLoopPost
        (.ok { contract := contract, locals := L2' } evm2) ∧
      collectCoreInv ee s0 v a' L2' evm2 ∧
      RD retdataLoopBytecode ee g s0 collectLoopHeaderPc
        (collectCarryStack a') a'.mem a'.aw (collectCarryRdata a') (collectCarryAcc a')
        k'' C'' := by
  let a' := collectSuccessNextCarry a out ptr postAwRead cA' σ' freePtr' inOffset copiedWord
  have hnPost :
      (collectRuntimePostLocals L out a.idx a.total).get? "n" =
        some (.int (Int.ofNat a.bound.toNat)) := by
    exact collectRuntimePostLocals_get_n hInv.2.1
  have hInvNext :
      collectCoreInv ee s0 v a'
        (collectRuntimePostLocals L out a.idx a.total) evm' := by
    exact collectCoreInv_next_of_success
      (a := a) (L := L) (L2 := collectRuntimePostLocals L out a.idx a.total)
      (evm := evm) (evm' := evm') (out := out) (ptr := ptr)
      (postAwRead := postAwRead) (freePtr' := freePtr') (inOffset := inOffset)
      (copiedWord := copiedWord) (cA' := cA') (σ' := σ') (A' := A')
      hInv
      collectRuntimePostLocals_get_i
      hnPost
      collectRuntimePostLocals_get_total
      hevm' hfitIdx hfitTotal
  refine ⟨a', L1, evm', L2, evm', k', C', Or.inl hbody, hpost, ?_, ?_⟩
  · subst L2
    exact hInvNext
  · subst L2
    subst L1
    simpa [a', collectSuccessNextCarry, collectCarryStack, collectCarryRdata, collectCarryAcc]
      using hrd

