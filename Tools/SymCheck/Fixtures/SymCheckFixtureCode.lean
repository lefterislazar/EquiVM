import Ethereum.Semantics

open Ethereum

/-- Small dynamic-branch bytecode used to compile-check generated symbolic edge theorems. -/
def symCheckBranchFixtureBytecode : ByteArray :=
  ⟨#[0x57, 0x00, 0x5b, 0x8b, 0x9f, 0x00, 0x5b, 0x56]⟩

/-- Concrete branches used to compile-check maximal deterministic trace generation. -/
def symCheckDeterministicFixtureBytecode : ByteArray :=
  ⟨#[0x60, 0x01, 0x60, 0x06, 0x57, 0x00, 0x5b, 0x60, 0x0b, 0x56, 0x00, 0x5b, 0x00,
      0x5b, 0x60, 0x0d, 0x56]⟩
