pragma solidity ^0.8.28;
contract DaiStandalone { mapping(address=>uint256) public wards; uint256 public totalSupply; mapping(address=>uint256) public balanceOf; mapping(address=>mapping(address=>uint256)) public allowance; uint8 public constant decimals=18; modifier auth(){require(wards[msg.sender]==1);_;} constructor(){wards[msg.sender]=1;} function rely(address u) external auth{wards[u]=1;} function deny(address u) external auth{wards[u]=0;} function approve(address u,uint256 x) external returns(bool){allowance[msg.sender][u]=x;return true;} function transfer(address d,uint256 x) external returns(bool){require(balanceOf[msg.sender]>=x);if(msg.sender!=d){balanceOf[msg.sender]-=x;balanceOf[d]+=x;}return true;} function mint(address u,uint256 x) external auth{balanceOf[u]+=x;totalSupply+=x;} function burn(uint256 x) external{balanceOf[msg.sender]-=x;totalSupply-=x;} }
