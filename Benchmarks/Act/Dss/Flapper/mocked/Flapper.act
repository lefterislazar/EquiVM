contract FlapperNoop
constructor()
creates
transition vatMove(address src, address dst, uint256 rad)
updates
transition gemMove(address src, address dst, uint256 wad)
updates
contract FlapperMocked
constructor(address<FlapperNoop> mock_)
creates
  mapping(address => uint256) wards := [CALLER => 1]
  mapping(uint256 => uint256) bid := []
  mapping(uint256 => uint256) lot := []
  mapping(uint256 => address) guy := []
  uint256 kicks := 0
  uint256 live := 1
  uint256 lid := 0
  uint256 fill := 0
  FlapperNoop mock := mock_
transition wards(address usr) : uint256
updates
returns wards[usr]
transition bid(uint256 id) : uint256
updates
returns bid[id]
transition lot(uint256 id) : uint256
updates
returns lot[id]
transition guy(uint256 id) : address
updates
returns guy[id]
transition kicks() : uint256
updates
returns kicks
transition live() : uint256
updates
returns live
transition lid() : uint256
updates
returns lid
transition fill() : uint256
updates
returns fill
transition mock() : address<FlapperNoop>
updates
returns mock
transition rely(address usr)
iff wards[CALLER] == 1
updates
  wards := wards[usr => 1]
transition deny(address usr)
iff wards[CALLER] == 1
updates
  wards := wards[usr => 0]
transition fileLid(uint256 data)
iff wards[CALLER] == 1
updates
  lid := data
transition kick(uint256 lot_, uint256 bid_) : uint256
iff
  wards[CALLER] == 1
  live == 1
  inRange(uint256, fill + lot_)
  fill + lot_ <= lid
  inRange(uint256, kicks + 1)
updates
  fill := fill + lot_
  kicks := kicks + 1
returns kicks + 1
transition cage(uint256 rad)
iff wards[CALLER] == 1
updates
  live := 0
