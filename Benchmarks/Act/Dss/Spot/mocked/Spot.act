contract SpotNoop

constructor()
creates

transition readValue(bytes32 ilk) : uint256
updates
returns 1000000000000000000

transition readValid(bytes32 ilk) : bool
updates
returns true

transition setSpot(bytes32 ilk, uint256 spot)
updates

contract SpotMocked

constructor(address<SpotNoop> mock_)
creates
  mapping(address => uint256) wards := [CALLER => 1]
  mapping(bytes32 => address) ilkPip := []
  mapping(bytes32 => uint256) ilkMat := []
  uint256 par := 1000000000000000000000000000
  uint256 live := 1
  SpotNoop mock := mock_

transition wards(address usr) : uint256
updates
returns wards[usr]

transition ilkPip(bytes32 ilk) : address
updates
returns ilkPip[ilk]

transition ilkMat(bytes32 ilk) : uint256
updates
returns ilkMat[ilk]

transition par() : uint256
updates
returns par

transition live() : uint256
updates
returns live

transition mock() : address<SpotNoop>
updates
returns mock

transition rely(address usr)
iff wards[CALLER] == 1
updates
  wards := wards[usr => 1]

transition deny(address usr)
iff wards[CALLER] == 1
updates
  wards := wards[usr => 0]

transition filePip(bytes32 ilk, address pip)
iff
  wards[CALLER] == 1
  live == 1
updates
  ilkPip := ilkPip[ilk => pip]

transition fileMat(bytes32 ilk, uint256 mat)
iff
  wards[CALLER] == 1
  live == 1
updates
  ilkMat := ilkMat[ilk => mat]

transition filePar(uint256 par_)
iff
  wards[CALLER] == 1
  live == 1
updates
  par := par_

transition cage()
iff wards[CALLER] == 1
updates
  live := 0

transition poke(bytes32 ilk)
updates
