pragma solidity ^0.8.28;
contract SpotVat { uint256 public writes; bytes32 public lastIlk; uint256 public lastSpot; function file(bytes32 i,uint256 s) external {writes+=1;lastIlk=i;lastSpot=s;} }
contract SpotStandalone { mapping(address=>uint256) public wards; mapping(bytes32=>uint256) public ilkMat; uint256 public par=10**27; uint256 public live=1; SpotVat public vat; modifier auth(){require(wards[msg.sender]==1);_;} constructor(address v){wards[msg.sender]=1;vat=SpotVat(v);} function rely(address u) external auth{wards[u]=1;} function deny(address u) external auth{wards[u]=0;} function fileMat(bytes32 i,uint256 x) external auth{require(live==1);ilkMat[i]=x;} function cage() external auth{live=0;} function poke(bytes32 i,uint256 value,bool valid) external{vat.file(i,valid?value:0);} }
