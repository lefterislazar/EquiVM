contract CureStandalone
constructor()
creates
 mapping(address=>uint256) wards := [CALLER=>1]
 uint256 live := 1
 uint256 wait := 0
transition wards(address u):uint256
updates
returns wards[u]
transition live():uint256
updates
returns live
transition wait():uint256
updates
returns wait
transition rely(address u)
iff wards[CALLER]==1 and live==1
updates
 wards:=wards[u=>1]
transition deny(address u)
iff wards[CALLER]==1 and live==1
updates
 wards:=wards[u=>0]
transition fileWait(uint256 x)
iff wards[CALLER]==1 and live==1
updates
 wait:=x
