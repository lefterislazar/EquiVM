contract PotVat
constructor()
creates
 uint256 moved:=0
transition moved():uint256
updates
returns moved
transition move(address s,address d,uint256 r)
iff inRange(uint256,moved+r)
updates
 moved:=moved+r
contract PotStandalone
constructor(address<PotVat> v)
creates
 mapping(address=>uint256) wards:=[CALLER=>1]
 mapping(address=>uint256) pie:=[]
 uint256 Pie:=0
 uint256 chi:=1000000000000000000000000000
 uint256 live:=1
 PotVat vat:=v
transition wards(address u):uint256
updates
returns wards[u]
transition pie(address u):uint256
updates
returns pie[u]
transition Pie():uint256
updates
returns Pie
transition chi():uint256
updates
returns chi
transition live():uint256
updates
returns live
transition vat():address<PotVat>
updates
returns vat
transition rely(address u)
iff wards[CALLER]==1
updates
 wards:=wards[u=>1]
transition deny(address u)
iff wards[CALLER]==1
updates
 wards:=wards[u=>0]
transition cage()
iff wards[CALLER]==1
updates
 live:=0
transition join(uint256 wad)
iff inRange(uint256,pie[CALLER]+wad) and inRange(uint256,Pie+wad) and inRange(uint256,chi*wad) and inRange(uint256,vat.moved+chi*wad)
updates
 pie:=pie[CALLER=>pie[CALLER]+wad]
 Pie:=Pie+wad
 vat.moved:=vat.moved+chi*wad
transition exit(uint256 wad)
iff wad<=pie[CALLER] and wad<=Pie and inRange(uint256,chi*wad) and inRange(uint256,vat.moved+chi*wad)
updates
 pie:=pie[CALLER=>pie[CALLER]-wad]
 Pie:=Pie-wad
 vat.moved:=vat.moved+chi*wad
