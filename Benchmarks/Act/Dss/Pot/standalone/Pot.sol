pragma solidity ^0.8.28;
contract PotVat { uint256 public moved; function move(address,address,uint256 rad) external { moved += rad; } }
contract PotStandalone { mapping(address=>uint256) public wards; mapping(address=>uint256) public pie; uint256 public Pie; uint256 public chi=10**27; uint256 public live=1; PotVat public vat; modifier auth(){require(wards[msg.sender]==1);_;} constructor(address v){wards[msg.sender]=1;vat=PotVat(v);} function rely(address u) external auth{wards[u]=1;} function deny(address u) external auth{wards[u]=0;} function cage() external auth{live=0;} function join(uint256 wad) external{pie[msg.sender]+=wad;Pie+=wad;vat.move(msg.sender,address(this),chi*wad);} function exit(uint256 wad) external{pie[msg.sender]-=wad;Pie-=wad;vat.move(address(this),msg.sender,chi*wad);} }
