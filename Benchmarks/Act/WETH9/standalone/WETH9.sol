pragma solidity ^0.8.28;
contract WETH9Standalone { uint8 public constant decimals=18; mapping(address=>uint256) public balanceOf; mapping(address=>mapping(address=>uint256)) public allowance; function deposit() external payable{balanceOf[msg.sender]+=msg.value;} function totalSupply() external view returns(uint256){return address(this).balance;} function approve(address u,uint256 x) external returns(bool){allowance[msg.sender][u]=x;return true;} function transfer(address d,uint256 x) external returns(bool){require(balanceOf[msg.sender]>=x);if(msg.sender!=d){balanceOf[msg.sender]-=x;balanceOf[d]+=x;}return true;} function transferFrom(address s,address d,uint256 x) external returns(bool){require(s==msg.sender||allowance[s][msg.sender]>=x);require(balanceOf[s]>=x);if(s!=msg.sender)allowance[s][msg.sender]-=x;if(s!=d){balanceOf[s]-=x;balanceOf[d]+=x;}return true;} }
